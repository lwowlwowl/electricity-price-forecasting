<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="RT-at-DA模型架构" id="rt-at-da-architecture">
    <mxGraphModel dx="1500" dy="1180" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="RT-at-DA Transformer 模型架构&#xa;D-1 10:00一次预测交付日D的24个实时市场价格" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1F2937;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="200" y="20" width="1100" height="60" as="geometry" /></mxCell>
        <mxCell id="history-inputs" value="五条历史输入流｜范围：[D-8日10:00, D-1日10:00)，共168个完整小时&#xa;DA价格 [B,168,1]　RT价格 [B,168,1]　Load [B,168,1]&#xa;System风电+光伏 [B,168,2]　Calendar [B,168,8]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="1000" height="100" as="geometry" /></mxCell>
        <mxCell id="stream-encoders" value="5个独立StreamEncoder（模型内部独立参数）&#xa;DA / RT / Load / System：Linear Projection + 2层时间Transformer + RoPE&#xa;Calendar：MLP Projection　→　每条流均为 [B,168,128]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="270" width="1000" height="100" as="geometry" /></mxCell>
        <mxCell id="source-stack" value="按来源维堆叠 + modality embedding&#xa;[B,168,5,128]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="430" width="660" height="70" as="geometry" /></mxCell>
        <mxCell id="source-attention" value="F0 同小时拼接投影（无来源注意力）&#xa;[B,168,5,128] → [B,168,640]&#xa;LayerNorm + Linear(640,128)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="560" width="460" height="100" as="geometry" /></mxCell>
        <mxCell id="source-pool" value="2层Pre-LN残差MLP&#xa;Linear(128,512) + GELU + Linear(512,128)&#xa;输出 [B,168,128]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="790" y="560" width="460" height="100" as="geometry" /></mxCell>
        <mxCell id="temporal-memory" value="跨时间建模&#xa;2层Temporal Transformer + RoPE + final LayerNorm&#xa;Shared Memory [B,168,128]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="720" width="660" height="90" as="geometry" /></mxCell>
        <mxCell id="target-calendar" value="交付日已知日历&#xa;cal_tgt [B,24,8]&#xa;不含未来真实DA、RT、负荷或风光" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="860" width="350" height="90" as="geometry" /></mxCell>
        <mxCell id="calendar-projection" value="目标日历投影&#xa;Linear(8,128) + GELU + LayerNorm&#xa;query_context [B,24,128]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="1010" width="350" height="90" as="geometry" /></mxCell>
        <mxCell id="query-decoder" value="24-Query Decoder&#xa;learnable query + query_pos + query_context&#xa;Query Self-Attention → Cross-Attention查询168个Memory token → FFN → LayerNorm&#xa;representation [B,24,128]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="880" width="620" height="130" as="geometry" /></mxCell>
        <mxCell id="price-head" value="RT价格头&#xa;Linear(128,1)&#xa;p_RT_at_DA_normalized [B,24]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1200" y="880" width="250" height="100" as="geometry" /></mxCell>
        <mxCell id="price-output" value="反归一化 + clamp&#xa;p_RT_at_DA [B,24]&#xa;对应D日00:00—23:00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="1040" width="250" height="90" as="geometry" /></mxCell>
        <mxCell id="independence-note" value="边界说明&#xa;本模型与DA模型、滚动RT模型只复用代码结构，不共享权重或checkpoint。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="1060" width="620" height="70" as="geometry" /></mxCell>
        <mxCell id="e-input-enc" value="5条流分别进入" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="history-inputs" target="stream-encoders"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-enc-stack" value="5 × [B,168,128]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#9673a6;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="stream-encoders" target="source-stack"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-stack-attn" value="同小时concat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#9673a6;strokeWidth=2;exitX=0.3;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="source-stack" target="source-attention"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-attn-pool" value="每小时1个投影token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#d79b00;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="source-attention" target="source-pool"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-pool-memory" value="每小时1个token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#9673a6;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="source-pool" target="temporal-memory"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-cal-proj" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="target-calendar" target="calendar-projection"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-memory-decoder" value="K/V：168个历史时间token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#9673a6;strokeWidth=2;exitX=0.6;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="temporal-memory" target="query-decoder"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-context-decoder" value="24个目标小时条件" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#6c8ebf;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="calendar-projection" target="query-decoder"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-decoder-head" value="[B,24,128]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#d79b00;strokeWidth=2;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" parent="1" source="query-decoder" target="price-head"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-head-output" value="真实美元/MWh尺度" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="price-head" target="price-output"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
