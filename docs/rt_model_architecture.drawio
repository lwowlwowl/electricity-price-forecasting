        <mxCell id="denorm" value="反归一化 + clamp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#64748B;fontColor=#334155;" vertex="1" parent="lane_output"><mxGeometry x="25" y="310" width="210" height="55" as="geometry"/></mxCell>
        <mxCell id="p_rt" value="未来 4 小时 RT 价格预测&#xa;&lt;b&gt;p_RT [B,4]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;fontColor=#14532D;fontStyle=1;fontSize=14;" vertex="1" parent="lane_output"><mxGeometry x="25" y="430" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="output_note" value="四个输出都参与监督；真正运行时由策略生成候选动作，并只执行第 1 小时" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;fontSize=11;" vertex="1" parent="lane_output"><mxGeometry x="25" y="545" width="210" height="65" as="geometry"/></mxCell>

