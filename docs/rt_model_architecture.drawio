<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="rt-model-v2" name="RT Model Architecture">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;独立 RT Transformer｜模型架构&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="每小时起报 → 预测未来 4 小时｜模型只输出价格；只执行第 1 步与 SOC 滚动属于验证/运行回路" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#526075;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="1250" height="30" as="geometry"/></mxCell>

        <mxCell id="lane_input" value="① 当前时点可见输入" style="swimlane;html=1;rounded=1;startSize=36;horizontal=1;container=1;collapsible=0;pointerEvents=0;fillColor=#F8FAFC;strokeColor=#60A5FA;fontColor=#1E3A8A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="290" height="650" as="geometry"/></mxCell>
        <mxCell id="lane_encode" value="② 五条流独立编码" style="swimlane;html=1;rounded=1;startSize=36;horizontal=1;container=1;collapsible=0;pointerEvents=0;fillColor=#FAF8FF;strokeColor=#8B5CF6;fontColor=#4C1D95;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="110" width="290" height="650" as="geometry"/></mxCell>
        <mxCell id="lane_fusion" value="③ 同小时来源交互 + 时间记忆" style="swimlane;html=1;rounded=1;startSize=36;horizontal=1;container=1;collapsible=0;pointerEvents=0;fillColor=#FAF8FF;strokeColor=#8B5CF6;fontColor=#4C1D95;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="110" width="320" height="650" as="geometry"/></mxCell>
        <mxCell id="lane_decoder" value="④ 4 个滚动查询" style="swimlane;html=1;rounded=1;startSize=36;horizontal=1;container=1;collapsible=0;pointerEvents=0;fillColor=#FAF8FF;strokeColor=#8B5CF6;fontColor=#4C1D95;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="990" y="110" width="300" height="650" as="geometry"/></mxCell>
        <mxCell id="lane_output" value="⑤ RT 价格输出" style="swimlane;html=1;rounded=1;startSize=36;horizontal=1;container=1;collapsible=0;pointerEvents=0;fillColor=#F7FFF9;strokeColor=#22C55E;fontColor=#14532D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1310" y="110" width="260" height="650" as="geometry"/></mxCell>

        <mxCell id="in_da" value="历史 DA 价&#xa;&lt;b&gt;[B,168,1]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;" vertex="1" parent="lane_input"><mxGeometry x="25" y="60" width="160" height="55" as="geometry"/></mxCell>
        <mxCell id="in_rt" value="历史 RT 价&#xa;&lt;b&gt;[B,168,1]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;" vertex="1" parent="lane_input"><mxGeometry x="25" y="135" width="160" height="55" as="geometry"/></mxCell>
        <mxCell id="in_load" value="历史负荷&#xa;&lt;b&gt;[B,168,1]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;" vertex="1" parent="lane_input"><mxGeometry x="25" y="210" width="160" height="55" as="geometry"/></mxCell>
        <mxCell id="in_system" value="历史风电 + 光伏&#xa;&lt;b&gt;[B,168,2]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;" vertex="1" parent="lane_input"><mxGeometry x="25" y="285" width="160" height="55" as="geometry"/></mxCell>
        <mxCell id="in_cal" value="历史日历&#xa;&lt;b&gt;[B,168,8]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;" vertex="1" parent="lane_input"><mxGeometry x="25" y="360" width="160" height="55" as="geometry"/></mxCell>
        <mxCell id="in_future" value="未来已知条件&#xa;已公布 DA 价 [B,4,1]&#xa;+ 日历 [B,4,8]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontStyle=1;" vertex="1" parent="lane_input"><mxGeometry x="25" y="475" width="235" height="80" as="geometry"/></mxCell>
        <mxCell id="input_guard" value="不输入：未来实际负荷、风光、RT 价" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=11;" vertex="1" parent="lane_input"><mxGeometry x="195" y="75" width="75" height="260" as="geometry"/></mxCell>

        <mxCell id="enc_da" value="DA Temporal Encoder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;" vertex="1" parent="lane_encode"><mxGeometry x="25" y="60" width="235" height="55" as="geometry"/></mxCell>
        <mxCell id="enc_rt" value="RT Temporal Encoder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;" vertex="1" parent="lane_encode"><mxGeometry x="25" y="135" width="235" height="55" as="geometry"/></mxCell>
        <mxCell id="enc_load" value="Load Temporal Encoder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;" vertex="1" parent="lane_encode"><mxGeometry x="25" y="210" width="235" height="55" as="geometry"/></mxCell>
        <mxCell id="enc_system" value="System Temporal Encoder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;" vertex="1" parent="lane_encode"><mxGeometry x="25" y="285" width="235" height="55" as="geometry"/></mxCell>
        <mxCell id="enc_cal" value="Calendar MLP Encoder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;" vertex="1" parent="lane_encode"><mxGeometry x="25" y="360" width="235" height="55" as="geometry"/></mxCell>
        <mxCell id="enc_note" value="结构与 DA 相似，但参数完全独立；不会加载或复用 DA 权重" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;fontSize=11;" vertex="1" parent="lane_encode"><mxGeometry x="25" y="485" width="235" height="70" as="geometry"/></mxCell>

        <mxCell id="stack" value="按同一小时堆叠五来源&#xa;&lt;b&gt;[B,168,5,D]&lt;/b&gt;&#xa;+ modality embedding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;fontStyle=1;" vertex="1" parent="lane_fusion"><mxGeometry x="35" y="75" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="source_attn" value="来源间 Self-Attention&#xa;每个小时只看 5 个来源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDD6FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontStyle=1;" vertex="1" parent="lane_fusion"><mxGeometry x="35" y="205" width="250" height="70" as="geometry"/></mxCell>
        <mxCell id="source_pool" value="可学习来源加权汇聚&#xa;权重 [B,168,5] → [B,168,D]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;" vertex="1" parent="lane_fusion"><mxGeometry x="35" y="325" width="250" height="70" as="geometry"/></mxCell>
        <mxCell id="memory" value="Temporal Transformer + LN&#xa;&lt;b&gt;RT Temporal Memory [B,168,D]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C4B5FD;strokeColor=#7C3AED;fontColor=#3B0764;fontStyle=1;" vertex="1" parent="lane_fusion"><mxGeometry x="35" y="455" width="250" height="75" as="geometry"/></mxCell>

        <mxCell id="queries" value="4 learnable queries&#xa;+ query_pos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;" vertex="1" parent="lane_decoder"><mxGeometry x="30" y="65" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="future_proj" value="未来条件投影（可训练）&#xa;Linear(9,D) + GELU + LN&#xa;&lt;b&gt;[B,4,9] → [B,4,D]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;" vertex="1" parent="lane_decoder"><mxGeometry x="30" y="175" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="query_self" value="Query Self-Attention&#xa;4 小时彼此感知" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;" vertex="1" parent="lane_decoder"><mxGeometry x="30" y="305" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="cross_attn" value="&lt;b&gt;Cross-Attention&lt;/b&gt;&#xa;Q=4 queries, K/V=168 memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C4B5FD;strokeColor=#7C3AED;fontColor=#3B0764;fontStyle=1;" vertex="1" parent="lane_decoder"><mxGeometry x="30" y="420" width="240" height="75" as="geometry"/></mxCell>
        <mxCell id="decoder_rep" value="FFN + final LayerNorm&#xa;&lt;b&gt;rep [B,4,D]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;" vertex="1" parent="lane_decoder"><mxGeometry x="30" y="545" width="240" height="65" as="geometry"/></mxCell>

