<?xml version="1.0" encoding="UTF-8"?><mxfile host="km.sankuai.com" type="embed"><diagram name="模型架构图" id="arch"><mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t1" value="&lt;b style=&quot;font-size:15px;color:#333;&quot;&gt;Decision-aware Multi-modal TSFM 模型架构图&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="10" width="1120" height="25" as="geometry" /></mxCell><mxCell id="scope" value="&lt;div style=&quot;font-size:10px;color:#0066CC;line-height:1.5;&quot;&gt;&lt;b&gt;适用任务: 日前预测 (Day-ahead)&lt;/b&gt; — 从零训练, 不使用预训练权重&lt;br/&gt;日内预测 (Intra-day): 复用本架构, 换 Head 或微调 [待确认]&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="38" width="1120" height="30" as="geometry" /></mxCell><mxCell id="l1" value="&lt;div style=&quot;font-size:10px;color:#AAA;font-weight:bold;&quot;&gt;1. 多模态输入&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="5" y="112" width="75" height="20" as="geometry" /></mxCell><mxCell id="i1" value="&lt;div style=&quot;font-size:11px;font-weight:bold;color:#0055A4;&quot;&gt;历史电价 Price&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#666;&quot;&gt;7天历史 (168h)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#F0F7FF;strokeColor=#0066CC;" vertex="1" parent="1"><mxGeometry x="80" y="100" width="170" height="50" as="geometry" /></mxCell><mxCell id="i2" value="&lt;div style=&quot;font-size:11px;font-weight:bold;color:#0055A4;&quot;&gt;历史负荷 Load&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#666;&quot;&gt;7天历史 (168h)&lt;/div&gt;" style="rounded=1;arcSiz