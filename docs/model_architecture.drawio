<mxCell id="71" value="&lt;div style=&quot;font-weight:bold;font-size:11px;color:#37474F;&quot;&gt;p_DA: 日前电价预测&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#888;margin-top:2px;&quot;&gt;[B, 48] 反归一化 + clamp&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#78909C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="150" y="990" width="200" height="45" as="geometry" /></mxCell>
<mxCell id="72" value="&lt;div style=&quot;font-weight:bold;font-size:11px;color:#37474F;&quot;&gt;p_RT|DA: 条件RT预测&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#888;margin-top:2px;&quot;&gt;[B, 48] 反归一化 + clamp&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#78909C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="990" width="200" height="45" as="geometry" /></mxCell>
