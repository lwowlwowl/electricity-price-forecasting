<mxCell id="78" value="&lt;div style=&quot;background-color:#FFFFFF;padding:1px 4px;border-radius:3px;font-size:9px;color:#666;&quot;&gt;输出: [B, 24, 4]&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="67" target="74"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="79" value="&lt;div style=&quot;font-size:10px;color:#999;line-height:1.6;&quot;&gt;TransformerBlock (pre-LN): x = x + Attn(LN(x)); x = x + FFN(LN(x)), FFN = Linear &gt; GELU &gt; Linear&lt;br/&gt;融合层: 关闭 RoPE (A1), 2 层, 使用 n_heads_fusion=4; 解码器同样用 n_heads_fusion&lt;br/&gt;解码器: Query Self-Attn 用 RotaryMHA, Cross-Attn 用 nn.MultiheadAttention (PyTorch 原生)&lt;br/&gt;反归一化: pDA 用 DA 的 mean/std, pRT|DA / pRT / pRT_windows 用 RT 的 mean/std, 再 clamp&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="100" y="1060" width="1200" height="70" as="geometry" /></mxCell>
</root>
</mxGraphModel>
