value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#0066CC;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="i4" target="e4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ie5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#0066CC;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;dashPattern=5 5;" edge="1" parent="1" source="i5" target="e5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ie6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#0066CC;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;dashPattern=5 5;" edge="1" parent="1" source="i6" target="e6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l3" value="&lt;div style=&quot;font-size:10px;color:#AAA;font-weight:bold;&quot;&gt;3. 跨模态融合&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="5" y="360" width="75" height="20" as="geometry" /></mxCell><mxCell id="f0" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#F1F8E9;strokeColor=#689F38;" vertex="1" parent="1"><mxGeometry x="80" y="320" width="1120" height="110" as="geometry" /></mxCell><mxCell id="ft" value="&lt;div style=&quot;font-size:13px;font-weight:bold;color:#33691E;&quot;&gt;Cross-modal Fusion (Cross Attention)&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="328" width="1120" height="20" as="geometry" /></mxCell><mxCell id="fi" value="&lt;div style=&quot;font-size:10px;color:#555;&quot;&gt;Weather-&gt;Load | Holiday-&gt;Load | Load-&gt;Price | Weather-&gt;Price | System-&gt;Price [可扩展]&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="90" y="352" width="1100" height="20" as="geometry" /></mxCell><mxCell id="sm" value="&lt;div style=&quot;font-size:11px;font-weight:bold;color:#33691E;&quot;&gt;Shared Memory h_i = TSFM_θ(X_i)&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#555;&quot;&gt;融合后的共享表示, K/V 供 Decoder 查询&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#689F38;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="460" y="382" width="360" height="40" as="geometry" /></mxCell><mxCell id="ef1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#689F38;exitX=0.5;exitY=1;entryX=0.083;entryY=0;" edge="1" parent="1" source="e1" target="f0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ef2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#689F38;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="e2" target="f0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ef3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#689F38;exitX=0.5;exitY=1;entryX=0.417;entryY=0;" edge="1" parent="1" source="e3" target="f0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ef4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#689F38;exitX=0.5;exitY=1;entryX=0.583;entryY=0;" edge="1" parent="1" source="e4" target="f0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ef5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#689F38;exitX=0.5;exitY=1;entryX=0.75;entryY=0;dashed=1;dashPattern=5 5;" edge="1" parent="1" source="e5" target="f0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ef6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#689F38;exitX=0.5;exitY=1;entryX=0.917;entryY=0;dashed=1;dashPattern=5 5;" edge="1" parent="1" source="e6" target="f0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l4" value="&lt;div style=&quot;font-size:10px;color:#AAA;font-weight:bold;&quot;&gt;4. Decoder&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="5" y="540" width="75" height="20" as="geometry" /></mxCell><mxCell id="d1" value="&lt;div style=&quot;font-size:11px;font-weight:bold;color:#5E35B1;&quot;&gt;96 Learnable Queries&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#666;&quot;&gt;每个 Query 对应未来一个时间点 (非自回归)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#EDE7F6;strokeColor=#7E57C2;" vertex="1" parent="1"><mxGeometry x="490" y="480" width="300" height="45" as="geometry" /></mxCell><mxCell id="d2" value="&lt;div style=&quot;font-size:11px;font-weight:bold;color:#5E35B1;&quot;&gt;Decoder Cross Attention&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#666;&quot;&gt;Q = Learnable Queries, K/V = Shared Memory&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#EDE7F6;strokeColor=#7E57C2;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="490" y="550" width="300" height="50" as="geometry" /></mxCell><mxCell id="d3" value="&lt;div style=&quot;font-size:11px;font-weight:bold;color:#5E35B1;&quot;&gt;Forecast Representation&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#666;&quot;&gt;96 x d_model, 一次 Forward 输出&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#EDE7F6;strokeColor=#7E57C2;" vertex="1" parent="1"><mxGeometry x="490" y="630" width="300" height="45" as="geometry" /></mxCell><mxCell id="sd" value="&lt;div style=&quot;background:#fff;padding:1px 4px;color:#689F38;border-radius:3px;font-size:10px;font-weight:bold;&quot;&gt;K, V&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#689F38;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="sm" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="qd" value="&lt;div style=&quot;background:#fff;padding:1px 4px;color:#7E57C2;border-radius:3px;font-size:10px;font-weight:bold;&quot;&gt;Q&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#7E57C2;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dd" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#7E57C2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l5" value="&lt;div style=&quot;font-size:10px;color:#AAA;font-weight:bold;&quot;&gt;5. 预测头&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="5" y="738" width="75" height="20" as="geometry" /></mxCell><mxCell id="h1" value="&lt;div style=&quot;font-size:11px;font-weight:bold;color:#CC7A00;&quot;&gt;Head_DA (日前)&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#666;&quot;&gt;较长窗口电价预测 (H24/H48)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#FFFBF0;strokeColor=#FF9900;" vertex="1" parent="1"><mxGeometry x="290" y="730" width="200" height="45" as="geometry" /></mxCell><mxCell id="h2" value="&lt;div style=&quot;font-size:11px;font-weight:bold;color:#CC7A00;&quot;&gt;Head_RT (实时)&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#666;&quot;&gt;较短窗口电价预测&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#FFFBF0;strokeColor=#FF9900;" vertex="1" parent="1"><mxGeometry x="540" y="730" width="200" height="45" as="geometry" /></mxCell><mxCell id="h3" value="&lt;div style=&quot;font-size:11px;font-weight:bold;color:#CC7A00;&quot;&gt;...可扩展&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#888;&quot;&gt;Load / BESS 等&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#FFFBF0;strokeColor=#FF9900;dashed=1;dashPattern=5 5;" vertex="1" parent="1"><mxGeometry x="790" y="730" width="200" height="45" as="geometry" /></mxCell><mxCell id="dh1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#FF9900;exitX=0.167;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d3" target="h1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dh2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#FF9900;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d3" target="h2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dh3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#FF9900;exitX=0.833;exitY=1;entryX=0.5;entryY=0;dashed=1;dashPattern=5 5;" edge="1" parent="1" source="d3" target="h3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="o1" value="&lt;div style=&quot;font-size:10px;font-weight:bold;color:#455A64;&quot;&gt;p̂_DA: 日前电价预测 (96点)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#F8F9FA;strokeColor=#B0BEC5;" vertex="1" parent="1"><mxGeometry x="290" y="825" width="200" height="35" as="geometry" /></mxCell><mxCell id="o2" value="&lt;div style=&quot;font-size:10px;font-weight:bold;color:#455A64;&quot;&gt;p̂_RT: 实时电价预测&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#F8F9FA;strokeColor=#B0BEC5;" vertex="1" parent="1"><mxGeometry x="540" y="825" width="200" height="35" as="geometry" /></mxCell><mxCell id="ho1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#B0BEC5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="h1" target="o1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ho2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#B0BEC5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="h2" target="o2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bb" value="&lt;div style=&quot;font-size:9px;color:#BBB;font-style:italic;&quot;&gt;Foundation Backbone (可复用, 端到端联合训练) — 换 Head 即可迁移任务&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=1.5;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#DDDDDD;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="65" y="185" width="1150" height="505" as="geometry" /></mxCell><mxCell id="note1" value="&lt;div style=&quot;font-size:9px;color:#999;line-height:1.5;&quot;&gt;参数量: 验证版~15M (d=256,2层) → 完整版~100M (d=512,4层) | Attention: MHA/可选MQA [待确认] | 可选GRU [待确认] | 训练: 2 epoch快速验证&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="875" width="1120" height="20" as="geometry" /></mxCell><mxCell id="note2" value="&lt;div style=&quot;font-size:9px;color:#0066CC;line-height:1.5;&quot;&gt;&lt;b&gt;迭代路径:&lt;/b&gt; Step1 最小改动(单Encoder+简单拼接) → Step2 多流Encoder+CrossAttn → Step3 +Decision-aware训练 | 对比基线: TimesFM/Chronos/Moirai/Toto (同参数量)&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="897" width="1120" height="20" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="训练回路" id="train"><mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="810" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t2" value="&lt;b style=&quot;font-size:15px;color:#333;&quot;&gt;Decision-aware 训练回路 (双结算)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="100" y="10" width="600" height="28" as="geometry" /></mxCell><mxCell id="inp" value="&lt;div style=&quot;font-size:12px;font-weight:bold;color:#0055A4;&quot;&gt;多模态输入 X_i&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#666;&quot;&gt;历史电价/负荷 + 天气预报 + 日历 + ...&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#F0F7FF;strokeColor=#0066CC;" vertex="1" parent="1"><mxGeometry x="300" y="55" width="280" height="42" as="geometry" /></mxCell><mxCell id="fm" value="&lt;div style=&quot;font-size:13px;font-weight:bold;color:#0055A4;&quot;&gt;Foundation Model f_θ&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#666;&quot;&gt;多流 Encoder + Fusion + Decoder&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#F0F7FF;strokeColor=#0066CC;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="125" width="280" height="48" as="geometry" /></mxCell><mxCell id="pda" value="&lt;div style=&quot;font-size:11px;font-weight:bold;color:#0055A4;&quot;&gt;p̂_DA (日前电价预测)&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#666;&quot;&gt;较长窗口, 用于日前计划&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#F0F7FF;strokeColor=#0066CC;" vertex="1" parent="1"><mxGeometry x="290" y="210" width="180" height="42" as="geometry" /></mxCell><mxCell id="prt" value="&lt;div style=&quot;font-size:11px;font-weight:bold;color:#0055A4;&quot;&gt;p̂_RT (实时电价预测)&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#666;&quot;&gt;较短窗口, 用于实时调整&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#F0F7FF;strokeColor=#0066CC;" vertex="1" parent="1"><mxGeometry x="530" y="210" width="180" height="42" as="geometry" /></mxCell><mxCell id="pda_s" value="&lt;div style=&quot;font-size:11px;font-weight:bold;color:#455A64;&quot;&gt;日前策略 π_DA&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#666;&quot;&gt;固定Greedy: 谷充峰放&lt;/div&gt;&lt;div style=&quot;font-size:8px;color:#999;&quot;&gt;不参与训练&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#F8F9FA;strokeColor=#B0BEC5;" vertex="1" parent="1"><mxGeometry x="290" y="295" width="180" height="55" as="geometry" /></mxCell><mxCell id="prt_s" value="&lt;div style=&quot;font-size:11px;font-weight:bold;color:#455A64;&quot;&gt;实时策略 π_RT&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#666;&quot;&gt;基于DA计划做偏差调整&lt;/div&gt;&lt;div style=&quot;font-size:8px;color:#999;&quot;&gt;不参与训练&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#F8F9FA;strokeColor=#B0BEC5;" vertex="1" parent="1"><mxGeometry x="530" y="295" width="180" height="55" as="geometry" /></mxCell><mxCell id="acts" value="&lt;div style=&quot;font-size:11px;font-weight:bold;color:#33691E;&quot;&gt;真实收益 R_i&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#555;&quot;&gt;u_DA x λ_DA + Δu_RT x λ_RT - 成本&lt;/div&gt;&lt;div style=&quot;font-size:8px;color:#999;&quot;&gt;用真实电价 p_i 结算&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#F1F8E9;strokeColor=#689F38;" vertex="1" parent="1"><mxGeometry x="300" y="395" width="280" height="55" as="geometry" /></mxCell><mxCell id="fl" value="&lt;div style=&quot;font-size:11px;font-weight:bold;color:#C62828;&quot;&gt;预测损失 L_pred&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#666;&quot;&gt;MAE / Huber / Quantile&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#FFEBEE;strokeColor=#D32F2F;" vertex="1" parent="1"><mxGeometry x="30" y="310" width="170" height="48" as="geometry" /></mxCell><mxCell id="orc" value="&lt;div style=&quot;font-size:10px;font-weight:bold;color:#455A64;&quot;&gt;Oracle 收益 R*_i&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#666;&quot;&gt;用真实电价跑同一策略&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#F8F9FA;strokeColor=#B0BEC5;" vertex="1" parent="1"><mxGeometry x="610" y="395" width="170" height="42" as="geometry" /></mxCell><mxCell id="bl" value="&lt;div style=&quot;font-size:11px;font-weight:bold;color:#C62828;&quot;&gt;业务损失 L_bus&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#666;&quot;&gt;= Regret = R*_i - R_i&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#FFEBEE;strokeColor=#D32F2F;" vertex="1" parent="1"><mxGeometry x="300" y="490" width="280" height="42" as="geometry" /></mxCell><mxCell id="tl" value="&lt;div style=&quot;font-size:13px;font-weight:bold;color:#333;&quot;&gt;Total Loss&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#666;&quot;&gt;L = αL_pred + βL_bus&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#FFF9C4;strokeColor=#F9A825;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="570" width="280" height="45" as="geometry" /></mxCell><mxCell id="bp" value="&lt;div style=&quot;font-size:11px;font-weight:bold;color:#0055A4;&quot;&gt;代理梯度回传&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#666;&quot;&gt;g = 2Δt(u_ref - u*), 前向hard/反向surrogate&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;dashed=1;dashPattern=8 4;fillColor=#F0F7FF;strokeColor=#0066CC;" vertex="1" parent="1"><mxGeometry x="300" y="650" width="280" height="45" as="geometry" /></mxCell><mxCell id="nt2" value="&lt;div style=&quot;font-size:10px;color:#555;line-height:1.6;&quot;&gt;&lt;b&gt;核心:&lt;/b&gt; 预测模型 f_θ 是训练对象, 储能策略 π 固定不学习。Forecast 是中间变量, Business Loss (Regret) 通过代理梯度回传, 让模型学习&quot;哪些预测误差真正影响收益&quot;。&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="730" width="680" height="45" as="geometry" /></mxCell><mxCell id="te1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="inp" target="fm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="te2a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;exitX=0.35;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fm" target="pda"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="te2b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;exitX=0.65;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fm" target="prt"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="te3a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pda" target="pda_s"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="te3b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="prt" target="prt_s"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="te4a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#689F38;exitX=0.5;exitY=1;entryX=0.35;entryY=0;" edge="1" parent="1" source="pda_s" target="acts"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="te4b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#689F38;exitX=0.5;exitY=1;entryX=0.65;entryY=0;" edge="1" parent="1" source="prt_s" target="acts"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="te5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#D32F2F;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="pda" target="fl"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="te6" value="&lt;div style=&quot;background:#fff;padding:1px 3px;color:#666;border-radius:3px;font-size:9px;&quot;&gt;R_i&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#D32F2F;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="acts" target="bl"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="te6b" value="&lt;div style=&quot;background:#fff;padding:1px 3px;color:#666;border-radius:3px;font-size:9px;&quot;&gt;R*_i&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#D32F2F;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="orc" target="bl"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="te7" value="&lt;div style=&quot;background:#fff;padding:1px 3px;color:#999;border-radius:3px;font-size:10px;&quot;&gt;α&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#D32F2F;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="fl" target="tl"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="te8" value="&lt;div style=&quot;background:#fff;padding:1px 3px;color:#999;border-radius:3px;font-size:10px;&quot;&gt;β&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#D32F2F;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bl" target="tl"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="te9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="tl" target="bp"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="te10" value="&lt;div style=&quot;background:#fff;padding:2px 5px;color:#0066CC;border-radius:3px;font-size:10px;font-weight:bold;&quot;&gt;更新 f_θ&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#0066CC;dashed=1;dashPattern=6 4;strokeWidth=2;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bp" target="fm"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>