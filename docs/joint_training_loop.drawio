<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="stage-a-huber" name="Stage A - Independent Huber">
    <mxGraphModel dx="2000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="a_title" value="&lt;b&gt;阶段 A｜三个独立模型的纯 Huber 预训练与融合消融&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="45" y="20" width="1500" height="42" as="geometry"/></mxCell>
        <mxCell id="a_subtitle" value="先让三个模型分别学会价格预测；训练损失不含收益项，但每个 epoch 的 checkpoint 和最终融合结构用冻结完整双结算验证收益选择" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#526075;" vertex="1" parent="1"><mxGeometry x="45" y="65" width="1800" height="32" as="geometry"/></mxCell>

        <mxCell id="a_split" value="&lt;b&gt;同一时间边界，不同样本单位&lt;/b&gt;&#xa;DA / RT-at-DA：1809 / 183 / 150日&#xa;滚动RT：43677 / 4414 / 3640个小时起点&#xa;顺序均为训练 / 验证 / report-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="165" width="230" height="150" as="geometry"/></mxCell>
        <mxCell id="a_contracts" value="&lt;b&gt;三套独立数据合同&lt;/b&gt;&#xa;DA：D-1→24h DA&#xa;RT-at-DA：D-1→24h RT&#xa;滚动RT：每小时→未来4h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="315" y="180" width="245" height="120" as="geometry"/></mxCell>
        <mxCell id="a_models" value="&lt;b&gt;独立候选 Transformer&lt;/b&gt;&#xa;DA：F0 / F1 / F2&#xa;RT-at-DA：F0 / F1 / F1b / F2&#xa;滚动RT：F0 / F1 / F1b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="170" width="270" height="140" as="geometry"/></mxCell>
        <mxCell id="a_predictions" value="&lt;b&gt;价格预测输出&lt;/b&gt;&#xa;p_DA[24]&#xa;p_RT_at_DA[24]&#xa;p_RT[4]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;strokeWidth=2;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="950" y="180" width="210" height="120" as="geometry"/></mxCell>
        <mxCell id="a_huber" value="&lt;b&gt;各自纯 Huber&lt;/b&gt;&#xa;预测与真实价格比较&#xa;三模型不共享 loss 图&#xa;无收益代理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=2;fontColor=#991B1B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1220" y="180" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="a_optimizers" value="&lt;b&gt;独立参数更新&lt;/b&gt;&#xa;各自 AMP / 梯度裁剪 / AdamW&#xa;各自 checkpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=2;fontColor=#991B1B;" vertex="1" parent="1"><mxGeometry x="1510" y="180" width="240" height="120" as="geometry"/></mxCell>

        <mxCell id="a_header_select" value="每个 epoch 与三 seed 的统一收益选择" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontStyle=1;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="45" y="395" width="600" height="30" as="geometry"/></mxCell>
        <mxCell id="a_val_forward" value="&lt;b&gt;验证集候选预测&lt;/b&gt;&#xa;只替换当前被比较的模型&#xa;其他模型、策略和BESS冻结" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;" vertex="1" parent="1"><mxGeometry x="1510" y="465" width="240" height="115" as="geometry"/></mxCell>
        <mxCell id="a_full_dual" value="&lt;b&gt;固定完整系统回放&lt;/b&gt;&#xa;价差 HardTopK + 锁定DA&#xa;滚动RT + 连续SOC&#xa;完整双结算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;strokeWidth=2;fontColor=#7C2D12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1210" y="455" width="240" height="135" as="geometry"/></mxCell>
        <mxCell id="a_val_metrics" value="&lt;b&gt;验证主指标&lt;/b&gt;&#xa;完整双结算日均净收益&#xa;MAE/RMSE、尾部、回撤辅助" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;strokeWidth=2;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="920" y="465" width="230" height="115" as="geometry"/></mxCell>
        <mxCell id="a_best_seed" value="&lt;b&gt;每个结构运行 3 seeds&lt;/b&gt;&#xa;先保存各seed最佳epoch&#xa;再报告均值、标准差和配对区间" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;" vertex="1" parent="1"><mxGeometry x="620" y="455" width="240" height="135" as="geometry"/></mxCell>
        <mxCell id="a_structure_select" value="&lt;b&gt;冻结最终结构&lt;/b&gt;&#xa;DA：F1 seed1&#xa;RT-at-DA：F0 seed1&#xa;滚动RT：F0 seed0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=3;fontColor=#14532D;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="315" y="455" width="245" height="135" as="geometry"/></mxCell>
        <mxCell id="a_baseline" value="&lt;b&gt;联合训练的 epoch 0 基线&lt;/b&gt;&#xa;三冻结checkpoint组合&#xa;验证日均净收益 123.062644" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=3;fontColor=#14532D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="455" width="210" height="135" as="geometry"/></mxCell>

        <mxCell id="a_report" value="report-only只在最终冻结后披露，不参与任何checkpoint、结构或超参数选择。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#64748B;fontColor=#334155;align=left;" vertex="1" parent="1"><mxGeometry x="45" y="675" width="570" height="70" as="geometry"/></mxCell>
        <mxCell id="a_note" value="阶段A的输出不是一个合并模型，而是三份独立的纯Huber checkpoint。它们既是最终冻结基线，也是阶段B联合收益导向微调的起点。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;align=left;" vertex="1" parent="1"><mxGeometry x="680" y="675" width="850" height="70" as="geometry"/></mxCell>

        <mxCell id="a_e_split_contract" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#3B82F6;" edge="1" parent="1" source="a_split" target="a_contracts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_e_contract_model" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#8B5CF6;" edge="1" parent="1" source="a_contracts" target="a_models"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_e_model_pred" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#8B5CF6;" edge="1" parent="1" source="a_models" target="a_predictions"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_e_pred_huber" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#EF4444;" edge="1" parent="1" source="a_predictions" target="a_huber"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_e_huber_opt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#EF4444;" edge="1" parent="1" source="a_huber" target="a_optimizers"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_e_opt_val" value="每个epoch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#64748B;fontColor=#334155;" edge="1" parent="1" source="a_optimizers" target="a_val_forward"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_e_val_system" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#F97316;" edge="1" parent="1" source="a_val_forward" target="a_full_dual"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_e_system_metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#22C55E;" edge="1" parent="1" source="a_full_dual" target="a_val_metrics"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_e_metrics_seed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#F59E0B;" edge="1" parent="1" source="a_val_metrics" target="a_best_seed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_e_seed_select" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#16A34A;" edge="1" parent="1" source="a_best_seed" target="a_structure_select"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_e_select_base" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#16A34A;" edge="1" parent="1" source="a_structure_select" target="a_baseline"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="a_leg_data" value="数据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="45" y="850" width="110" height="35" as="geometry"/></mxCell>
        <mxCell id="a_leg_model" value="模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;" vertex="1" parent="1"><mxGeometry x="175" y="850" width="110" height="35" as="geometry"/></mxCell>
        <mxCell id="a_leg_loss" value="损失 / 更新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;" vertex="1" parent="1"><mxGeometry x="305" y="850" width="130" height="35" as="geometry"/></mxCell>
        <mxCell id="a_leg_fixed" value="固定系统" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;fontColor=#7C2D12;" vertex="1" parent="1"><mxGeometry x="455" y="850" width="120" height="35" as="geometry"/></mxCell>
        <mxCell id="a_leg_output" value="选模 / 输出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="595" y="850" width="130" height="35" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="stage-b-v2" name="Stage B - Joint Decision-Aware V2">
    <mxGraphModel dx="2100" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="b_title" value="&lt;b&gt;阶段 B｜V2 三模型联合 Decision-Aware 微调&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="45" y="20" width="1500" height="42" as="geometry"/></mxCell>
        <mxCell id="b_subtitle" value="三个 Transformer 仍然独立；同一完整双结算收益为三路 price head 提供训练信号，验证集完整双结算日均净收益是唯一 checkpoint 主score" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#526075;" vertex="1" parent="1"><mxGeometry x="45" y="65" width="1900" height="32" as="geometry"/></mxCell>

        <mxCell id="b_sources" value="&lt;b&gt;加载阶段A冻结起点&lt;/b&gt;&#xa;DA F1 seed1&#xa;RT-at-DA F0 seed1&#xa;滚动RT F0 seed0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="160" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="b_scope" value="&lt;b&gt;保护强基线&lt;/b&gt;&#xa;冻结三个骨干&#xa;每路只训练 price head（129参数）&#xa;dropout关闭；weight_decay=0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;" vertex="1" parent="1"><mxGeometry x="345" y="150" width="270" height="140" as="geometry"/></mxCell>
        <mxCell id="b_anchor_cache" value="&lt;b&gt;缓存原 checkpoint 输出&lt;/b&gt;&#xa;训练集1808日&#xa;DA[1808,24]&#xa;RT-at-DA[1808,24]｜RT[1808,24,4]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="675" y="145" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="b_episode" value="&lt;b&gt;完整交付日 episode&lt;/b&gt;&#xa;每批16个连续训练日&#xa;每一天：1个DA + 1个RT-at-DA&#xa;+ 24个滚动RT样本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="400" width="260" height="140" as="geometry"/></mxCell>
        <mxCell id="b_forward" value="&lt;b&gt;三个独立模型同时前向&lt;/b&gt;&#xa;p_DA[16,24]&#xa;p_RT_at_DA[16,24]&#xa;p_RT[16,24,4]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="365" y="400" width="260" height="140" as="geometry"/></mxCell>
        <mxCell id="b_anchor_loss" value="&lt;b&gt;源输出锚定损失 L_anchor&lt;/b&gt;&#xa;当前输出对齐缓存输出&#xa;不再追真实价格 Huber&#xa;防止无收益信号时漂移" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=2;fontColor=#991B1B;" vertex="1" parent="1"><mxGeometry x="685" y="400" width="270" height="140" as="geometry"/></mxCell>

        <mxCell id="b_spread_zo" value="&lt;b&gt;DA共同价差零阶信号&lt;/b&gt;&#xa;spread=p_DA−p_RT_at_DA&#xa;ε=5｜8个正交方向｜逐日反馈&#xa;同一梯度反向分给DA与RT-at-DA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;strokeWidth=2;fontColor=#7C2D12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1025" y="270" width="300" height="145" as="geometry"/></mxCell>
        <mxCell id="b_rt_zo" value="&lt;b&gt;滚动RT分组零阶信号&lt;/b&gt;&#xa;ε=10｜4个正交方向&#xa;每个4维窗口完整覆盖&#xa;逐小时/逐组结算反馈" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;strokeWidth=2;fontColor=#7C2D12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1025" y="490" width="300" height="145" as="geometry"/></mxCell>
        <mxCell id="b_proxy" value="&lt;b&gt;收益代理损失 L_proxy&lt;/b&gt;&#xa;spread信号 + RT信号&#xa;sample_sum_mean归约&#xa;训练效用含10%尾部正则" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=2;fontColor=#991B1B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1390" y="380" width="260" height="145" as="geometry"/></mxCell>
        <mxCell id="b_total" value="&lt;b&gt;总损失&lt;/b&gt;&#xa;L_total = α·L_anchor + β·L_proxy&#xa;β按epoch预设退火&#xa;HardTopK不假装可微" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCA5A5;strokeColor=#DC2626;strokeWidth=3;fontColor=#7F1D1D;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1710" y="380" width="260" height="145" as="geometry"/></mxCell>
        <mxCell id="b_optimizers" value="&lt;b&gt;同一步联合更新&lt;/b&gt;&#xa;DA / RT-at-DA / RT 三个AdamW&#xa;分别裁剪、分别step&#xa;模型参数仍不共享" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=3;fontColor=#4C1D95;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1710" y="625" width="260" height="145" as="geometry"/></mxCell>

        <mxCell id="b_validation" value="&lt;b&gt;每个epoch完整验证&lt;/b&gt;&#xa;182日连续SOC + 完整双结算&#xa;主score：mean_daily_revenue&#xa;epoch 0原系统也参加比较" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=3;fontColor=#14532D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1390" y="665" width="260" height="145" as="geometry"/></mxCell>
        <mxCell id="b_checkpoints" value="&lt;b&gt;两类 checkpoint&lt;/b&gt;&#xa;best_validation_revenue.pt：最佳模型&#xa;latest.pt：模型+优化器+RNG精确续训&#xa;最多8轮；patience=3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="1040" y="675" width="285" height="145" as="geometry"/></mxCell>
        <mxCell id="b_three_seeds" value="&lt;b&gt;正式3 seeds结果&lt;/b&gt;&#xa;124.13 / 123.48 / 123.88 USD/日&#xa;均值123.83 ± 0.33&#xa;平均相对基线 +0.77 USD/日" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=3;fontColor=#14532D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="685" y="675" width="285" height="145" as="geometry"/></mxCell>
        <mxCell id="b_report" value="&lt;b&gt;report-only披露&lt;/b&gt;&#xa;2026上半年150日&#xa;不参与checkpoint或调参&#xa;三seed均值66.15，未高于基线66.35" style="shape=note;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#64748B;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="365" y="675" width="260" height="145" as="geometry"/></mxCell>
        <mxCell id="b_final" value="&lt;b&gt;本阶段冻结结论&lt;/b&gt;&#xa;三个独立模型 + V2联合微调&#xa;验证小幅、跨seed一致改善&#xa;下一步：多节点/多市场外部验证" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=3;fontColor=#78350F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="675" width="260" height="145" as="geometry"/></mxCell>

        <mxCell id="b_e_sources_scope" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#8B5CF6;" edge="1" parent="1" source="b_sources" target="b_scope"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b_e_scope_cache" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#3B82F6;" edge="1" parent="1" source="b_scope" target="b_anchor_cache"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b_e_sources_forward" value="加载权重" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;dashed=1;strokeColor=#8B5CF6;fontColor=#4C1D95;" edge="1" parent="1" source="b_sources" target="b_forward"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b_e_episode_forward" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#3B82F6;" edge="1" parent="1" source="b_episode" target="b_forward"><mxGeometry relative="1" as="geometry"/></mxCell>
