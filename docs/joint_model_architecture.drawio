<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="joint-system-final" name="Joint Model Architecture">
    <mxGraphModel dx="2350" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2350" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;最终联合系统架构｜三个独立 Transformer + 完整双结算&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1500" height="42" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="模型不合并、不共享权重；DA 与 RT-at-DA 在 D-1 形成锁定计划，滚动 RT 在交付日逐小时执行，SOC 在连续日期间继承" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#526075;" vertex="1" parent="1"><mxGeometry x="50" y="65" width="1800" height="30" as="geometry"/></mxCell>

        <mxCell id="header_da" value="D-1 10:00｜日前计划" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontStyle=1;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="70" y="125" width="400" height="30" as="geometry"/></mxCell>
        <mxCell id="da_model" value="&lt;b&gt;独立 DA Transformer&lt;/b&gt;&#xa;结构F1｜纯Huber起点seed1｜V2更新price head&#xa;5来源独立编码 → 同小时来源注意力&#xa;→ 时间建模 → p_DA[24]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="180" width="310" height="130" as="geometry"/></mxCell>
        <mxCell id="rtada_model" value="&lt;b&gt;独立 RT-at-DA Transformer&lt;/b&gt;&#xa;结构F0｜纯Huber起点seed1｜V2更新price head&#xa;5来源拼接投影 → 残差MLP → 时间Memory&#xa;→ p_RT_at_DA[24]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="370" width="310" height="130" as="geometry"/></mxCell>
        <mxCell id="spread" value="&lt;b&gt;共同日前决策信号&lt;/b&gt;&#xa;spread[24] = p_DA − p_RT_at_DA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;strokeWidth=2;fontColor=#14532D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="285" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="da_policy" value="&lt;b&gt;固定 DA HardTopK&lt;/b&gt;&#xa;Bottom-K充电 / Top-K放电&#xa;输出计划动作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;strokeWidth=2;fontColor=#7C2D12;" vertex="1" parent="1"><mxGeometry x="800" y="285" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="plan_soc" value="&lt;b&gt;计划 SOC 投影&lt;/b&gt;&#xa;功率 / 容量 / 效率约束&#xa;只修正不可行计划" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;strokeWidth=2;fontColor=#7C2D12;" vertex="1" parent="1"><mxGeometry x="1110" y="285" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="locked_da" value="&lt;b&gt;锁定 DA 头寸 u_DA[24]&lt;/b&gt;&#xa;进入 RT 后不可偷偷修改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#14532D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1420" y="285" width="230" height="100" as="geometry"/></mxCell>

        <mxCell id="header_rt" value="交付日逐小时｜滚动实时执行" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontStyle=1;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="70" y="580" width="460" height="30" as="geometry"/></mxCell>
        <mxCell id="rt_model" value="&lt;b&gt;独立滚动 RT Transformer&lt;/b&gt;&#xa;结构F0｜纯Huber起点seed0｜V2更新price head&#xa;每小时读取过去168h，预测未来4h&#xa;p_RT[t:t+4]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="635" width="310" height="130" as="geometry"/></mxCell>
        <mxCell id="rt_policy" value="&lt;b&gt;固定 rt_only HardTopK&lt;/b&gt;&#xa;结合当前真实 SOC&#xa;形成未来4h意向动作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;strokeWidth=2;fontColor=#7C2D12;" vertex="1" parent="1"><mxGeometry x="470" y="650" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="execute_first" value="&lt;b&gt;只执行第1小时&lt;/b&gt;&#xa;u_RT_actual[t]&#xa;下一小时重新预测" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;strokeWidth=2;fontColor=#7C2D12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="650" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="actual_soc" value="&lt;b&gt;更新真实 SOC&lt;/b&gt;&#xa;连续日期继承&#xa;只有数据缺口开启新连续段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#14532D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1110" y="650" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="true_prices" value="&lt;b&gt;事后真实结算数据&lt;/b&gt;&#xa;真实 DA / RT 价格&#xa;退化成本；偏差罚金当前关闭" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="1420" y="650" width="230" height="100" as="geometry"/></mxCell>

        <mxCell id="settlement" value="&lt;b&gt;完整双结算&lt;/b&gt;&#xa;DA价 × u_DA&#xa;+ RT价 × (u_RT_actual − u_DA)&#xa;− 退化成本 − 可选偏差罚金" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=3;fontColor=#7C2D12;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1740" y="430" width="250" height="145" as="geometry"/></mxCell>
        <mxCell id="metrics" value="&lt;b&gt;最终输出 / 评价&lt;/b&gt;&#xa;完整双结算日均净收益（主指标）&#xa;正收益日比例 / 最差10% / 最大回撤&#xa;MAE / RMSE（辅助）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=3;fontColor=#14532D;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2040" y="425" width="260" height="155" as="geometry"/></mxCell>
        <mxCell id="terminal_note" value="&lt;b&gt;期末 SOC 单独报告&lt;/b&gt;&#xa;单位 MWh；当前不换算成钱&#xa;不计入主收益" style="shape=note;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#64748B;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="1740" y="690" width="250" height="95" as="geometry"/></mxCell>
        <mxCell id="boundary_note" value="训练时三个模型可以接收同一收益信号，但仍各自保存参数和优化器。V2只更新三个price head；单一部署候选使用验证最强的V2 seed0联合checkpoint，论文结果报告三个V2 seeds。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="875" width="1050" height="70" as="geometry"/></mxCell>

        <mxCell id="e_da_spread" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#8B5CF6;" edge="1" parent="1" source="da_model" target="spread"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_rtada_spread" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#8B5CF6;" edge="1" parent="1" source="rtada_model" target="spread"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_spread_policy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#F97316;" edge="1" parent="1" source="spread" target="da_policy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_da_policy_soc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#F97316;" edge="1" parent="1" source="da_policy" target="plan_soc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_plan_locked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#16A34A;" edge="1" parent="1" source="plan_soc" target="locked_da"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_locked_settle" value="DA头寸" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#16A34A;fontColor=#14532D;" edge="1" parent="1" source="locked_da" target="settlement"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e_rt_model_policy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#8B5CF6;" edge="1" parent="1" source="rt_model" target="rt_policy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_policy_execute" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#F97316;" edge="1" parent="1" source="rt_policy" target="execute_first"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_execute_soc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#16A34A;" edge="1" parent="1" source="execute_first" target="actual_soc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_soc_feedback" value="下一小时SOC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;dashed=1;strokeColor=#16A34A;fontColor=#14532D;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="actual_soc" target="rt_policy"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1225" y="825"/><mxPoint x="595" y="825"/></Array></mxGeometry></mxCell>
        <mxCell id="e_soc_settle" value="实际动作 / SOC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#16A34A;fontColor=#14532D;exitX=1;exitY=0.35;entryX=0;entryY=0.75;" edge="1" parent="1" source="actual_soc" target="settlement"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1375" y="685"/><mxPoint x="1375" y="800"/><mxPoint x="1685" y="800"/><mxPoint x="1685" y="539"/></Array></mxGeometry></mxCell>
        <mxCell id="e_prices_settle" value="结算价" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#3B82F6;fontColor=#1E3A8A;" edge="1" parent="1" source="true_prices" target="settlement"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_settle_metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#16A34A;" edge="1" parent="1" source="settlement" target="metrics"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_soc_terminal" value="段末MWh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;dashed=1;strokeColor=#64748B;fontColor=#334155;" edge="1" parent="1" source="actual_soc" target="terminal_note"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="legend_model" value="独立可训练模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;" vertex="1" parent="1"><mxGeometry x="1250" y="900" width="155" height="35" as="geometry"/></mxCell>
        <mxCell id="legend_policy" value="固定策略 / 结算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;fontColor=#7C2D12;" vertex="1" parent="1"><mxGeometry x="1425" y="900" width="155" height="35" as="geometry"/></mxCell>
        <mxCell id="legend_data" value="真实数据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="1600" y="900" width="130" height="35" as="geometry"/></mxCell>
        <mxCell id="legend_output" value="状态 / 输出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="1750" y="900" width="130" height="35" as="geometry"/></mxCell>
        <mxCell id="legend_note" value="说明 / 边界" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;" vertex="1" parent="1"><mxGeometry x="1900" y="900" width="130" height="35" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
