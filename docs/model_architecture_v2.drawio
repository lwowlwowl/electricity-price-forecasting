<mxCell id="nt" value="&lt;div style=&quot;font-size:10px;color:#555;line-height:1.6;&quot;&gt;&lt;b&gt;核心:&lt;/b&gt; π 替换为凸优化层(LP), 用扰动法(加高斯噪声ε)让解可微 → 梯度从 R_i 直接穿过 π 回传到 f_θ, 标准 autograd 即可。&lt;br/&gt;&lt;b&gt;参考:&lt;/b&gt; Perturbed Decision-Focused Learning (Columbia, 2024, IEEE Trans. Smart Grid, arXiv:2406.17085)&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1">
<mxGeometry x="30" y="745" width="700" height="50" as="geometry" />
</mxCell></root></mxGraphModel></diagram>
