        </mxCell>
        <mxCell id="i3" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#F0F7FF;strokeColor=#0066CC;" value="&lt;div style=&quot;font-size:11px;font-weight:bold;color:#0055A4&quot;&gt;天气 Weather&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#666&quot;&gt;未来天气预报(已知)&lt;/div&gt;" vertex="1">
