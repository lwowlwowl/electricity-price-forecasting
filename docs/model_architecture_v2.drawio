        <mxCell id="acts" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#F1F8E9;strokeColor=#689F38;" value="&lt;div style=&quot;font-size:11px;font-weight:bold;color:#33691E&quot;&gt;真实收益 R_i&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#666&quot;&gt;u_DA×λ + Δu_RT×λ − 成本&lt;/div&gt;&lt;div style=&quot;font-size:8px;color:#999&quot;&gt;用 realized RT price 结算, 梯度穿过 π&lt;/div&gt;" vertex="1">
