<mxCell id="bl" value="&lt;div style=&quot;font-size:11px;font-weight:bold;color:#C62828;&quot;&gt;业务损失 L_bus&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#666;&quot;&gt;= Regret = R*_i - R_i&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#FFEBEE;strokeColor=#D32F2F;" vertex="1" parent="1">
