<mxCell id="tl" value="&lt;div style=&quot;font-size:11px;font-weight:bold;color:#333;&quot;&gt;Total Loss&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#666;&quot;&gt;L = αL_pred + βL_bus (α可→0, 纯业务损失驱动)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFF9C4;strokeColor=#F9A825;" vertex="1" parent="1">
