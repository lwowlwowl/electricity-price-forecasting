        <mxCell id="e_pred_huber" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#EF4444;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_rt" target="huber"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_truth_huber" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#3B82F6;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="truth_rt" target="huber"><mxGeometry relative="1" as="geometry"/></mxCell>
