        <mxCell id="e_truth_metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#3B82F6;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="val_truth" target="pred_metrics"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_val_pred_policy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#F97316;" edge="1" parent="1" source="val_pred" target="policy"><mxGeometry relative="1" as="geometry"/></mxCell>
