        <mxCell id="leg_model" value="可训练模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;" vertex="1" parent="legend"><mxGeometry x="165" y="38" width="135" height="30" as="geometry"/></mxCell>
        <mxCell id="leg_fixed" value="固定策略 / 执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;fontColor=#7C2D12;" vertex="1" parent="legend"><mxGeometry x="315" y="38" width="145" height="30" as="geometry"/></mxCell>
