<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="rt-train-v1" name="RT Training Loop">
    <mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;独立 RT Transformer｜训练与滚动验证回路&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="正式基线：4步Huber｜候选分支：Huber + 4小时约束MPC零阶代理；候选测试下降，未覆盖正式方案" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#526075;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="1450" height="30" as="geometry"/></mxCell>

        <mxCell id="lane_forward" value="① 训练批次与模型前向" style="swimlane;html=1;rounded=1;startSize=36;horizontal=1;container=1;collapsible=0;pointerEvents=0;fillColor=#F8FAFC;strokeColor=#60A5FA;fontColor=#1E3A8A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="320" height="700" as="geometry"/></mxCell>
        <mxCell id="lane_opt" value="② Huber + 可选MPC代理与参数更新" style="swimlane;html=1;rounded=1;startSize=36;horizontal=1;container=1;collapsible=0;pointerEvents=0;fillColor=#FFF8F8;strokeColor=#EF4444;fontColor=#991B1B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="110" width="350" height="700" as="geometry"/></mxCell>
        <mxCell id="lane_val" value="③ 每轮验证：模型预测（no_grad）" style="swimlane;html=1;rounded=1;startSize=36;horizontal=1;container=1;collapsible=0;pointerEvents=0;fillColor=#FAF8FF;strokeColor=#8B5CF6;fontColor=#4C1D95;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="110" width="320" height="700" as="geometry"/></mxCell>
        <mxCell id="lane_roll" value="④ MPC滚动验证 + 完整双结算最终选择" style="swimlane;html=1;rounded=1;startSize=36;horizontal=1;container=1;collapsible=0;pointerEvents=0;fillColor=#FFFDF8;strokeColor=#F59E0B;fontColor=#78350F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="110" width="580" height="700" as="geometry"/></mxCell>

        <mxCell id="train_batch" value="训练 batch（时点 t）&#xa;历史 [t−168,t)&#xa;+ 已公布 DA 价 / 日历 [t,t+4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;" vertex="1" parent="lane_forward"><mxGeometry x="35" y="60" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="rt_model" value="&lt;b&gt;RT Transformer fθ&lt;/b&gt;&#xa;完整结构见模型架构图" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;fontStyle=1;fontSize=14;" vertex="1" parent="lane_forward"><mxGeometry x="35" y="200" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="p_rt" value="未来 4 小时预测&#xa;&lt;b&gt;p_RT [B,4]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;fontColor=#14532D;fontStyle=1;" vertex="1" parent="lane_forward"><mxGeometry x="35" y="330" width="250" height="70" as="geometry"/></mxCell>
        <mxCell id="truth_rt" value="真实 RT 目标&#xa;&lt;b&gt;y_RT [B,4]&lt;/b&gt;&#xa;四个 horizon 都参与监督" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;" vertex="1" parent="lane_forward"><mxGeometry x="35" y="460" width="250" height="75" as="geometry"/></mxCell>
        <mxCell id="train_note" value="正式基线只用Huber；MPC候选从已有checkpoint微调，不改变模型结构" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;fontSize=11;" vertex="1" parent="lane_forward"><mxGeometry x="35" y="590" width="250" height="60" as="geometry"/></mxCell>

        <mxCell id="huber" value="&lt;b&gt;监督损失&lt;/b&gt;&#xa;L = Huber(p_RT, y_RT)&#xa;/ pred_scale" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;fontStyle=1;" vertex="1" parent="lane_opt"><mxGeometry x="40" y="75" width="270" height="85" as="geometry"/></mxCell>
        <mxCell id="zero_grad" value="&lt;b&gt;候选分支&lt;/b&gt;&#xa;固定4小时MPC + BESS收益&#xa;两点扰动 → L_proxy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;" vertex="1" parent="lane_opt"><mxGeometry x="40" y="205" width="270" height="75" as="geometry"/></mxCell>
        <mxCell id="backward" value="L_total = αL_pred + βL_proxy&#xa;正式基线取 β=0&#xa;GradScaler.backward()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;" vertex="1" parent="lane_opt"><mxGeometry x="40" y="325" width="270" height="80" as="geometry"/></mxCell>
        <mxCell id="clip" value="unscale_ + clip_grad_norm_" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;" vertex="1" parent="lane_opt"><mxGeometry x="40" y="435" width="270" height="55" as="geometry"/></mxCell>
        <mxCell id="step" value="GradScaler.step(AdamW)&#xa;+ scaler.update()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;fontStyle=1;" vertex="1" parent="lane_opt"><mxGeometry x="40" y="540" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="updated" value="更新参数 θ → 下一 batch / epoch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;fontStyle=1;" vertex="1" parent="lane_opt"><mxGeometry x="40" y="640" width="270" height="45" as="geometry"/></mxCell>

        <mxCell id="val_data" value="Validation split&#xa;按时间顺序、不打乱" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;" vertex="1" parent="lane_val"><mxGeometry x="35" y="75" width="250" height="70" as="geometry"/></mxCell>
        <mxCell id="val_model" value="同一 RT 模型&#xa;model.eval() + no_grad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;" vertex="1" parent="lane_val"><mxGeometry x="35" y="200" width="250" height="70" as="geometry"/></mxCell>
        <mxCell id="val_pred" value="所有滚动窗口预测&#xa;&lt;b&gt;forecasts [N,4]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;fontColor=#14532D;fontStyle=1;" vertex="1" parent="lane_val"><mxGeometry x="35" y="325" width="250" height="70" as="geometry"/></mxCell>
        <mxCell id="val_truth" value="真实目标与执行时价格&#xa;y_RT [N,4]&#xa;结算仅用 y_RT[:,0]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;" vertex="1" parent="lane_val"><mxGeometry x="35" y="455" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="pred_metrics" value="预测指标&#xa;4 步 MAE / RMSE&#xa;+ 第 1 小时 MAE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;fontColor=#14532D;" vertex="1" parent="lane_val"><mxGeometry x="35" y="590" width="250" height="70" as="geometry"/></mxCell>

        <mxCell id="policy" value="4小时约束MPC&#xa;比较3⁴=81条动作路线&#xa;&lt;b&gt;只取最优路线第1步&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;fontColor=#7C2D12;fontStyle=1;" vertex="1" parent="lane_roll"><mxGeometry x="35" y="65" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="execute" value="逐小时只执行第 1 步&#xa;按 SOC / 功率 / 日放电上限&#xa;裁剪为 actual action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;fontColor=#7C2D12;" vertex="1" parent="lane_roll"><mxGeometry x="305" y="65" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="soc" value="连续维护真实 SOC&#xa;下一小时使用新预测窗口&#xa;跨日不重置 SOC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;fontColor=#7C2D12;" vertex="1" parent="lane_roll"><mxGeometry x="305" y="205" width="240" height="85" as="geometry"/></mxCell>
        <mxCell id="settle" value="训练期滚动RT诊断&#xa;实际价格结算 − 吞吐成本&#xa;连续SOC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;fontColor=#7C2D12;" vertex="1" parent="lane_roll"><mxGeometry x="35" y="205" width="240" height="85" as="geometry"/></mxCell>
        <mxCell id="rolling_metrics" value="每个seed按验证集&#xa;&lt;b&gt;MPC mean_daily_revenue&lt;/b&gt;&#xa;保存候选checkpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;fontColor=#14532D;" vertex="1" parent="lane_roll"><mxGeometry x="170" y="345" width="240" height="85" as="geometry"/></mxCell>
        <mxCell id="checkpoint" value="多个seed + 多个DA参考&#xa;完整双结算验证收益选方案&#xa;测试集不参与选择" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;fontColor=#14532D;fontStyle=1;" vertex="1" parent="lane_roll"><mxGeometry x="170" y="485" width="240" height="85" as="geometry"/></mxCell>
        <mxCell id="test" value="最终测试只查看一次&#xa;MPC 87.18 &lt; 正式rt_only 89.44&#xa;&lt;b&gt;候选不晋级&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#64748B;fontColor=#334155;" vertex="1" parent="lane_roll"><mxGeometry x="170" y="620" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="scope_note" value="正式方案仍为纯Huber RT seed 2 + rt_only；旧track_adjust已废弃" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;fontSize=11;" vertex="1" parent="lane_roll"><mxGeometry x="425" y="485" width="125" height="145" as="geometry"/></mxCell>

        <mxCell id="e_batch_model" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#3B82F6;" edge="1" parent="1" source="train_batch" target="rt_model"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_model_pred" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#8B5CF6;" edge="1" parent="1" source="rt_model" target="p_rt"><mxGeometry relative="1" as="geometry"/></mxCell>
