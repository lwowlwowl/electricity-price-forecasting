<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="km.sankuai.com" type="embed">
<diagram name="训练回路" id="train">
<mxGraphModel dx="1300" dy="1220" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1220" math="0" shadow="0">
<root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="2" value="&lt;div style=&quot;font-weight:bold;font-size:16px;color:#6A1B9A;&quot;&gt;正式实验版 (v8) — Decision-aware 训练回路 (双结算)&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#888;margin-top:3px;&quot;&gt;零阶梯度 (ZO) + HardTopK 策略 (不可微) + BESS 双结算仿真 | alpha/beta 退火&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="100" y="15" width="1100" height="50" as="geometry" /></mxCell>
<mxCell id="3" value="&lt;div style=&quot;font-weight:bold;font-size:12px;color:#1565C0;&quot;&gt;多模态输入 X_i&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#777;margin-top:2px;&quot;&gt;历史电价/负荷 + 系统 + 日历 (5流)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="325" y="85" width="350" height="50" as="geometry" /></mxCell>
<mxCell id="4" value="&lt;div style=&quot;font-weight:bold;font-size:12px;color:#1565C0;&quot;&gt;Full Model f_theta&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#777;margin-top:2px;&quot;&gt;多流 Encoder + Cross Attention + 并行 Query Decoder&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="175" width="400" height="55" as="geometry" /></mxCell>
<mxCell id="5" value="&lt;div style=&quot;background-color:#FFFFFF;padding:1px 4px;border-radius:3px;font-size:9px;color:#666;&quot;&gt;输出: 5 流 ctx, 各 [B, 168, *]&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="6" value="&lt;div style=&quot;font-weight:bold;font-size:12px;color:#1565C0;&quot;&gt;预测输出&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#777;margin-top:2px;&quot;&gt;p_DA [B,48]  p_RT|DA [B,48]  p_RT [B,24]  p_RT_windows [B,24,4]&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#aaa;margin-top:2px;&quot;&gt;真实电价尺度 (反归一化 + clamp)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="275" y="275" width="450" height="55" as="geometry" /></mxCell>
<mxCell id="7" value="&lt;div style=&quot;background-color:#FFFFFF;padding:1px 4px;border-radius:3px;font-size:9px;color:#666;&quot;&gt;输出: rep [B, 48, 256] &gt; 预测头&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4" target="6"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="8" value="&lt;div style=&quot;font-weight:bold;font-size:12px;color:#C62828;&quot;&gt;预测损失 L_pred&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#777;margin-top:2px;&quot;&gt;v8: Huber (delta=1.0) | 默认: half_se 0.5*MSE (fp32)&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#aaa;margin-top:2px;&quot;&gt;LD = Huber(pDA) + Huber(pRT|DA); LR = Huber(pRT_windows); L_pred = LD + LR&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#EF5350;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="400" width="300" height="60" as="geometry" /></mxCell>
<mxCell id="9" value="&lt;div style=&quot;background-color:#FFFFFF;padding:1px 4px;border-radius:3px;font-size:9px;color:#666;&quot;&gt;输出: p_DA/p_RT|DA [B,48], p_RT_windows [B,24,4]&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#EF5350;" edge="1" parent="1" source="6" target="8"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="10" value="&lt;div style=&quot;font-weight:bold;font-size:12px;color:#E65100;&quot;&gt;真实电价 targets&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#777;margin-top:2px;&quot;&gt;price_da_tgt [B,48], price_rt_tgt [B,48] (结算用前 24h)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FFA000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="330" width="300" height="45" as="geometry" /></mxCell>
<mxCell id="11" value="&lt;div style=&quot;background-color:#FFFFFF;padding:1px 4px;border-radius:3px;font-size:9px;color:#666;&quot;&gt;输出: 真值 [B, 48] / [B, 24, 4]&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#999;" edge="1" parent="1" source="10" target="8"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="12" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#AB47BC;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="520" y="370" width="720" height="360" as="geometry" /></mxCell>
<mxCell id="13" value="&lt;div style=&quot;font-weight:bold;font-size:11px;color:#AB47BC;&quot;&gt;零阶梯度路径 (不可微, 无 backward 穿过此区域)&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="530" y="375" width="500" height="16" as="geometry" /></mxCell>
<mxCell id="14" value="&lt;div style=&quot;font-weight:bold;font-size:12px;color:#7B1FA2;&quot;&gt;1. HardTopK 策略 pi&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#777;margin-top:2px;&quot;&gt;torch.topk 选 Top-K 放电 / Bot-K 充电 (不可微), K_c = K_d = 4&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#aaa;margin-top:2px;&quot;&gt;价差门控: 仅保留 (c_dis - c_chg) &gt; kappa/eta (v8 约 6.0) 的配对&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#AB47BC;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="540" y="400" width="330" height="60" as="geometry" /></mxCell>
<mxCell id="15" value="&lt;div style=&quot;background-color:#FFFFFF;padding:1px 4px;border-radius:3px;font-size:9px;color:#666;&quot;&gt;输出: 价差 d = p_DA - p_RT|DA [B,48]; p_RT [B,24]&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#AB47BC;" edge="1" parent="1" source="6" target="14"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="16" value="&lt;div style=&quot;font-weight:bold;font-size:12px;color:#2E7D32;&quot;&gt;2. BESS 双结算仿真 (forward_dual, 结算前 24h)&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#777;margin-top:2px;&quot;&gt;R = p_DA*u_DA + p_RT*(u_RT_act - u_DA) - kappa*(d_act + c_act) - P_dev&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#aaa;margin-top:2px;&quot;&gt;偏差罚金 P_dev = 2|p_RT| * max(|delta_u| - 3%|u_DA|, 0)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#66BB6A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="900" y="405" width="310" height="55" as="geometry" /></mxCell>
<mxCell id="17" value="&lt;div style=&quot;background-color:#FFFFFF;padding:1px 4px;border-radius:3px;font-size:9px;color:#666;&quot;&gt;输出: u_DA [B, 48], u_RT [B, 24] (取值 -1/0/+1)&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#AB47BC;" edge="1" parent="1" source="14" target="16"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="18" value="&lt;div style=&quot;background-color:#FFFFFF;padding:1px 4px;border-radius:3px;font-size:9px;color:#666;&quot;&gt;输出: 真实 p_DA / p_RT [B, 24]&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#999;" edge="1" parent="1" source="10" target="16"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="19" value="&lt;div style=&quot;font-weight:bold;font-size:12px;color:#5E35B1;&quot;&gt;3. 零阶梯度估计 (Nesterov-Spokoiny 双点)&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#777;margin-top:2px;&quot;&gt;g = (1/K) * sum_k [F(p+eps*z) - F(p-eps*z)] / (2*eps) * z,  F = -R&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#aaa;margin-top:2px;&quot;&gt;对 DA / RT|DA / RT 三个任务独立扰动, K=2, rho=0.05, eps_DA / eps_RT 分开&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#AB47BC;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="540" y="485" width="670" height="55" as="geometry" /></mxCell>
<mxCell id="20" value="&lt;div style=&quot;font-size:9px;color:#AB47BC;font-style:italic;&quot;&gt;ZO 内部: 每个扰动样本 p+/p- 重复调用上面的 步骤1+步骤2 计算 R+/R-&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="540" y="465" width="670" height="16" as="geometry" /></mxCell>
<mxCell id="21" value="&lt;div style=&quot;font-weight:bold;font-size:12px;color:#5E35B1;&quot;&gt;4. 代理损失 L_proxy&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#777;margin-top:2px;&quot;&gt;L_proxy = [dot(p_DA, g_DA) + dot(p_RT|DA, g_RT|DA) + mean(p_RT * g_RT)] / proxy_scale&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#aaa;margin-top:2px;&quot;&gt;梯度注入: grad(L_proxy) = g_zo; DA / RT|DA 用点积 (不除 H), RT 用均值&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#AB47BC;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="540" y="570" width="670" height="55" as="geometry" /></mxCell>
<mxCell id="22" value="&lt;div style=&quot;background-color:#FFFFFF;padding:1px 4px;border-radius:3px;font-size:9px;color:#666;&quot;&gt;输出: g_DA [B,48], g_RT|DA [B,48], g_RT [B,24] (detached)&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#AB47BC;" edge="1" parent="1" source="19" target="21"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="23" value="&lt;div style=&quot;font-weight:bold;font-size:12px;color:#546E7A;&quot;&gt;Oracle 收益 R*_i (scipy linprog)&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#777;margin-top:2px;&quot;&gt;用真实电价解 LP 求真上界 (无梯度)&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#aaa;margin-top:2px;&quot;&gt;启用罚金时退化为单结算 LP (u_RT=u_DA 最优) | 仅日志, 不回传&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#78909C;strokeWidth=1.5;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="900" y="650" width="310" height="55" as="geometry" /></mxCell>
<mxCell id="24" value="&lt;div style=&quot;background-color:#FFFFFF;padding:1px 4px;border-radius:3px;font-size:9px;color:#666;&quot;&gt;输出: R [B] — 与 R* 对比算 regret&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#78909C;dashed=1;dashPattern=6 3;" edge="1" parent="1" source="16" target="23"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="25" value="&lt;div style=&quot;font-weight:bold;font-size:12px;color:#C62828;&quot;&gt;Total Loss&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#777;margin-top:2px;&quot;&gt;L = alpha * L_pred / pred_scale + beta * L_proxy / proxy_scale&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#FFD54F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="750" width="400" height="50" as="geometry" /></mxCell>
<mxCell id="26" value="&lt;div style=&quot;background-color:#FFFFFF;padding:1px 4px;border-radius:3px;font-size:9px;color:#666;&quot;&gt;输出: L_pred (标量) × alpha&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#EF5350;" edge="1" parent="1" source="8" target="25"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="27" value="&lt;div style=&quot;background-color:#FFFFFF;padding:1px 4px;border-radius:3px;font-size:9px;color:#666;&quot;&gt;输出: L_proxy (标量) × beta&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#AB47BC;" edge="1" parent="1" source="21" target="25"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="28" value="&lt;div style=&quot;font-size:9px;color:#999;&quot;&gt;退火: pretrain 8轮 (alpha=1, beta=0) &gt; 线性退火 12轮 &gt; alpha=0.5, beta=0.5 (v8, 共 20 epoch)&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="250" y="802" width="500" height="16" as="geometry" /></mxCell>
<mxCell id="29" value="&lt;div style=&quot;font-weight:bold;font-size:12px;color:#37474F;&quot;&gt;标准 autograd 回传&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#777;margin-top:2px;&quot;&gt;AdamW + grad_clip + AMP autocast&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#78909C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="350" y="825" width="300" height="50" as="geometry" /></mxCell>
<mxCell id="30" value="&lt;div style=&quot;background-color:#FFFFFF;padding:1px 4px;border-radius:3px;font-size:9px;color:#666;&quot;&gt;输出: L (标量) — .backward()&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="25" target="29"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="31" value="&lt;div style=&quot;background-color:#FFFFFF;padding:1px 4px;border-radius:3px;font-size:9px;color:#666;&quot;&gt;输出: 参数更新 Δtheta&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#66BB6A;dashed=1;dashPattern=6 3;" edge="1" parent="1" source="29" target="4"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="32" value="&lt;div style=&quot;font-size:10px;color:#999;line-height:1.6;&quot;&gt;核心: 策略 pi 不可微 (HardTopK topk), 用零阶梯度 (Nesterov-Spokoiny 2017) 估计代理梯度, 通过 L_proxy 注入 autograd&lt;br/&gt;BESS: 1MW / 4MWh, eta=0.95, kappa=5.7 $/MWh (v8 从 27 下调), SOC 0.4~3.6 MWh, E_cyc=4 MWh/日&lt;br/&gt;启用偏差罚金时 u_RT 先跟随 u_DA (plan_track_override), 仅在 u_DA=0 的时段保留 TopK 套利动作&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="100" y="905" width="1100" height="55" as="geometry" /></mxCell>
</root>
</mxGraphModel>
</diagram>
</mxfile>