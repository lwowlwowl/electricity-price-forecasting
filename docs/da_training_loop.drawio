<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="da-training-final" name="DA Final Training Loop">
    <mxGraphModel dx="1800" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;独立 DA Transformer｜最终纯 Huber 训练与融合选模&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1250" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="F0 / F1 / F2 使用同一数据和训练预算；训练只优化价格预测，checkpoint 与结构按冻结完整双结算验证收益选择" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#526075;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1500" height="30" as="geometry"/></mxCell>

        <mxCell id="header_train" value="① 每个结构、每个 seed 的纯 Huber 训练" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=15;fontStyle=1;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="650" height="30" as="geometry"/></mxCell>
        <mxCell id="train_data" value="&lt;b&gt;训练样本：1809个交付日&lt;/b&gt;&#xa;历史 168h + 目标日日历&#xa;真实 DA 价格 y_DA[24]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="40" y="155" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="candidate_model" value="&lt;b&gt;独立 DA Transformer&lt;/b&gt;&#xa;分别训练 F0 / F1 / F2&#xa;不共享 checkpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="155" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="prediction" value="&lt;b&gt;p_DA[24]&lt;/b&gt;&#xa;反归一化到真实价格尺度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="580" y="155" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="huber" value="&lt;b&gt;纯 Huber 损失&lt;/b&gt;&#xa;Huber(p_DA, y_DA)&#xa;无收益代理项" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="850" y="155" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="backward" value="AMP backward&#xa;梯度裁剪&#xa;AdamW.step()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;" vertex="1" parent="1"><mxGeometry x="1120" y="155" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="updated" value="&lt;b&gt;更新当前候选参数&lt;/b&gt;&#xa;进入下一 batch / epoch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1390" y="155" width="220" height="90" as="geometry"/></mxCell>

        <mxCell id="header_select" value="② 每个 epoch 的统一完整双结算验证与三 seed 结构选择" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=15;fontStyle=1;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="760" height="30" as="geometry"/></mxCell>
        <mxCell id="val_forward" value="&lt;b&gt;验证集前向&lt;/b&gt;&#xa;183 个交付日&#xa;model.eval() + no_grad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="1390" y="400" width="220" height="95" as="geometry"/></mxCell>
        <mxCell id="full_dual" value="&lt;b&gt;冻结完整系统&lt;/b&gt;&#xa;RT-at-DA + 滚动 RT 固定&#xa;价差 HardTopK + 连续 SOC&#xa;完整双结算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;fontColor=#7C2D12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1120" y="395" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="val_metrics" value="&lt;b&gt;验证指标&lt;/b&gt;&#xa;主指标：日均净收益&#xa;辅助：MAE / RMSE / 尾部 / 回撤" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="850" y="395" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="best_ckpt" value="&lt;b&gt;保存当前 seed 最佳 checkpoint&lt;/b&gt;&#xa;只看验证集&#xa;report-only 不参与选择" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;fontColor=#14532D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="395" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="three_seed" value="&lt;b&gt;每种结构运行 3 seeds&lt;/b&gt;&#xa;报告均值、标准差&#xa;配对收益区间" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;" vertex="1" parent="1"><mxGeometry x="310" y="395" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="select_f1" value="&lt;b&gt;最终选择：DA F1 seed1&lt;/b&gt;&#xa;F1 均值弱胜出&#xa;但相对 F0 未显著" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="395" width="220" height="105" as="geometry"/></mxCell>

        <mxCell id="report_only" value="&lt;b&gt;2026 上半年 report-only&lt;/b&gt;&#xa;冻结选择后只披露一次&#xa;不能用于调参或回选" style="shape=note;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#64748B;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="575" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="result_note" value="结构结论：F0 105.84±0.99；F1 107.57±2.80；F2 107.02±3.49 USD/日。&#xa;本图描述独立 DA 的最终训练，不包含后续 V2 联合 decision-aware 微调。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;align=left;" vertex="1" parent="1"><mxGeometry x="400" y="575" width="720" height="90" as="geometry"/></mxCell>

        <mxCell id="e_data_model" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#3B82F6;" edge="1" parent="1" source="train_data" target="candidate_model"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_model_pred" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#8B5CF6;" edge="1" parent="1" source="candidate_model" target="prediction"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_pred_loss" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#EF4444;" edge="1" parent="1" source="prediction" target="huber"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_loss_back" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#EF4444;" edge="1" parent="1" source="huber" target="backward"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_back_update" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#8B5CF6;" edge="1" parent="1" source="backward" target="updated"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_update_val" value="每个 epoch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#64748B;fontColor=#334155;" edge="1" parent="1" source="updated" target="val_forward"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_val_system" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#F97316;" edge="1" parent="1" source="val_forward" target="full_dual"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_system_metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#22C55E;" edge="1" parent="1" source="full_dual" target="val_metrics"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_metrics_ckpt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#22C55E;" edge="1" parent="1" source="val_metrics" target="best_ckpt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ckpt_seeds" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#F59E0B;" edge="1" parent="1" source="best_ckpt" target="three_seed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_seeds_select" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#16A34A;" edge="1" parent="1" source="three_seed" target="select_f1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_select_report" value="冻结后" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;dashed=1;strokeColor=#64748B;fontColor=#334155;" edge="1" parent="1" source="select_f1" target="report_only"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="legend_data" value="数据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="120" height="35" as="geometry"/></mxCell>
        <mxCell id="legend_model" value="模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;" vertex="1" parent="1"><mxGeometry x="180" y="760" width="120" height="35" as="geometry"/></mxCell>
        <mxCell id="legend_loss" value="损失 / 更新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;" vertex="1" parent="1"><mxGeometry x="320" y="760" width="130" height="35" as="geometry"/></mxCell>
        <mxCell id="legend_fixed" value="固定策略 / 结算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;fontColor=#7C2D12;" vertex="1" parent="1"><mxGeometry x="470" y="760" width="150" height="35" as="geometry"/></mxCell>
        <mxCell id="legend_metric" value="选模 / 输出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="640" y="760" width="130" height="35" as="geometry"/></mxCell>
        <mxCell id="legend_note" value="说明 / 实验控制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;" vertex="1" parent="1"><mxGeometry x="790" y="760" width="150" height="35" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
