      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="当前 DA 训练与留一市场评价｜无 ID 通用模型" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1500" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="四折 LOMO：每折训练 3 个市场、整市场留出 1 个；训练目标是价格误差，盈利只在三模型汇合后评价。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#52606d;" vertex="1" parent="1"><mxGeometry x="30" y="67" width="1500" height="55" as="geometry"/></mxCell>
        <mxCell id="fold" value="LOMO 折定义
CAISO / ERCOT / NYISO / PJM
每次选 1 个完整市场作为未见目标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f7e8;strokeColor=#23a566;strokeWidth=2;fontSize=14;fontColor=#163b2b;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="train" value="训练市场数据（3市）
2020–2022；168h→24h
market-node balanced
每市场 16,350 样本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f7e8;strokeColor=#23a566;strokeWidth=2;fontSize=14;fontColor=#163b2b;" vertex="1" parent="1"><mxGeometry x="340" y="145" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="norm" value="按样本 Context-Robust
历史中位数 / MAD
不拟合目标节点 scaler
不向网络传 ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#deecff;strokeColor=#3b82f6;strokeWidth=2;fontSize=14;fontColor=#173d72;" vertex="1" parent="1"><mxGeometry x="640" y="145" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="model" value="DA 无 ID 模型
F1 来源注意力
全部参数可训练" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee5ff;strokeColor=#7b4ce2;strokeWidth=2;fontSize=14;fontColor=#33205f;" vertex="1" parent="1"><mxGeometry x="940" y="145" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="loss" value="训练损失：MAE
标准化 24h 价格逐元素 L1
盈利、LP/MPC 不反向传播" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde6e6;strokeColor=#d84a4a;strokeWidth=2;fontSize=14;fontColor=#6a2020;" vertex="1" parent="1"><mxGeometry x="1240" y="145" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="optim" value="AdamW
lr=2e-4，weight_decay=0.01
AMP + grad clip 1.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0d9;strokeColor=#ef8f1f;strokeWidth=2;fontSize=14;fontColor=#633b0d;" vertex="1" parent="1"><mxGeometry x="940" y="355" width="250" height="115" as="geometry"/></mxCell>
        <mxCell id="val" value="训练市场 2023 验证
节点等权 → 市场宏 MAE
ReduceLROnPlateau" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#deecff;strokeColor=#3b82f6;strokeWidth=2;fontSize=14;fontColor=#173d72;" vertex="1" parent="1"><mxGeometry x="640" y="355" width="250" height="115" as="geometry"/></mxCell>
        <mxCell id="select" value="最多 20 epoch
patience=7 早停
保存 Top-3；seed=0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0d9;strokeColor=#ef8f1f;strokeWidth=2;fontSize=14;fontColor=#633b0d;" vertex="1" parent="1"><mxGeometry x="340" y="355" width="250" height="115" as="geometry"/></mxCell>
        <mxCell id="holdout" value="留出市场 2023 零样本推理
显式删除 node_id / market_id
整市场未参加训练" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f7e8;strokeColor=#23a566;strokeWidth=2;fontSize=14;fontColor=#163b2b;" vertex="1" parent="1"><mxGeometry x="40" y="355" width="250" height="115" as="geometry"/></mxCell>
        <mxCell id="metric" value="留出评价
逐节点 MAE/RMSE → 节点宏平均；与同市场 lag-168 比较
