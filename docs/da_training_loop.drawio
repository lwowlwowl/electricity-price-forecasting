<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="da-train-v1" name="DA Training Loop">
    <mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;独立 DA Transformer｜训练回路&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="监督预测 + 零阶决策代理｜HardTopK 与 BESS 不可微；验证集按 DA-only 平均收益选 checkpoint" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#526075;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="1300" height="30" as="geometry"/></mxCell>

        <mxCell id="lane_forward" value="① 训练批次与模型前向" style="swimlane;html=1;rounded=1;startSize=36;horizontal=1;container=1;collapsible=0;pointerEvents=0;fillColor=#F8FAFC;strokeColor=#60A5FA;fontColor=#1E3A8A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="310" height="700" as="geometry"/></mxCell>
        <mxCell id="lane_loss" value="② 损失构造：监督路径 + 零阶路径" style="swimlane;html=1;rounded=1;startSize=36;horizontal=1;container=1;collapsible=0;pointerEvents=0;fillColor=#FFFDF8;strokeColor=#F59E0B;fontColor=#78350F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="110" width="650" height="700" as="geometry"/></mxCell>
        <mxCell id="lane_update" value="③ 参数更新" style="swimlane;html=1;rounded=1;startSize=36;horizontal=1;container=1;collapsible=0;pointerEvents=0;fillColor=#FFF8F8;strokeColor=#EF4444;fontColor=#991B1B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1030" y="110" width="280" height="700" as="geometry"/></mxCell>
        <mxCell id="lane_select" value="④ 验证、选模与最终评估" style="swimlane;html=1;rounded=1;startSize=36;horizontal=1;container=1;collapsible=0;pointerEvents=0;fillColor=#F7FFF9;strokeColor=#22C55E;fontColor=#14532D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1330" y="110" width="330" height="700" as="geometry"/></mxCell>

        <mxCell id="train_batch" value="训练 batch&#xa;历史 168h + 目标日日历&#xa;&lt;b&gt;真实 DA 价 y_DA [B,24]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;" vertex="1" parent="lane_forward"><mxGeometry x="30" y="60" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="da_model" value="&lt;b&gt;DA Transformer fθ&lt;/b&gt;&#xa;完整结构见模型架构图" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;fontStyle=1;fontSize=14;" vertex="1" parent="lane_forward"><mxGeometry x="30" y="190" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="p_da" value="DA 价格预测&#xa;&lt;b&gt;p_DA [B,24]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;fontColor=#14532D;fontStyle=1;" vertex="1" parent="lane_forward"><mxGeometry x="30" y="320" width="250" height="70" as="geometry"/></mxCell>
        <mxCell id="truth_da" value="真实 DA 价&#xa;&lt;b&gt;y_DA [B,24]&lt;/b&gt;&#xa;监督 + 事后结算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;" vertex="1" parent="lane_forward"><mxGeometry x="30" y="455" width="250" height="75" as="geometry"/></mxCell>
        <mxCell id="forward_note" value="前向输出为真实价格尺度：反归一化后 clamp" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;fontSize=11;" vertex="1" parent="lane_forward"><mxGeometry x="30" y="585" width="250" height="60" as="geometry"/></mxCell>

        <mxCell id="pred_loss" value="&lt;b&gt;监督预测损失&lt;/b&gt;&#xa;L_pred = Huber(p_DA, y_DA) / pred_scale" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;" vertex="1" parent="lane_loss"><mxGeometry x="30" y="70" width="270" height="75" as="geometry"/></mxCell>
        <mxCell id="schedule" value="α / β 退火&#xa;前 4 epoch：β=0&#xa;随后 6 epoch 线性加入 L_proxy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;" vertex="1" parent="lane_loss"><mxGeometry x="350" y="70" width="260" height="75" as="geometry"/></mxCell>
        <mxCell id="zo_band" value="零阶梯度路径（无 backward 穿过 HardTopK / BESS）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#7C2D12;" vertex="1" parent="lane_loss"><mxGeometry x="30" y="180" width="550" height="25" as="geometry"/></mxCell>
        <mxCell id="perturb" value="双点扰动预测&#xa;p⁺ = p + εz，p⁻ = p − εz&#xa;K 个方向" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;fontColor=#7C2D12;" vertex="1" parent="lane_loss"><mxGeometry x="30" y="220" width="270" height="80" as="geometry"/></mxCell>
        <mxCell id="hardtopk" value="固定 HardTopK 策略&#xa;Top-4 放电 / Bottom-4 充电&#xa;&lt;b&gt;u_DA⁺ / u_DA⁻&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;fontColor=#7C2D12;" vertex="1" parent="lane_loss"><mxGeometry x="350" y="220" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="bess" value="BESS 物理执行仿真&#xa;SOC / 效率 / 成本 / 循环限制&#xa;按真实 DA 价结算 R⁺ / R⁻" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;fontColor=#7C2D12;" vertex="1" parent="lane_loss"><mxGeometry x="350" y="350" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="zo_grad" value="零阶梯度估计&#xa;g_ZO = mean[(F⁺−F⁻)/(2ε) · z]&#xa;F = −R" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;fontColor=#7C2D12;" vertex="1" parent="lane_loss"><mxGeometry x="30" y="350" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="proxy_loss" value="&lt;b&gt;代理损失&lt;/b&gt;&#xa;L_proxy = dot(p_DA, stopgrad(g_ZO))&#xa;/ proxy_scale" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;" vertex="1" parent="lane_loss"><mxGeometry x="30" y="490" width="270" height="80" as="geometry"/></mxCell>
        <mxCell id="total_loss" value="&lt;b&gt;Total Loss&lt;/b&gt;&#xa;L = α · L_pred + β · L_proxy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCA5A5;strokeColor=#DC2626;fontColor=#7F1D1D;fontStyle=1;fontSize=14;" vertex="1" parent="lane_loss"><mxGeometry x="350" y="505" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="scope_note" value="收益口径：DA-only 物理执行代理，不是 DA/RT 双结算最终收益" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;fontSize=11;" vertex="1" parent="lane_loss"><mxGeometry x="350" y="610" width="260" height="55" as="geometry"/></mxCell>

        <mxCell id="zero_grad" value="optimizer.zero_grad()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;" vertex="1" parent="lane_update"><mxGeometry x="30" y="120" width="220" height="55" as="geometry"/></mxCell>
        <mxCell id="backward" value="L.backward()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;fontStyle=1;" vertex="1" parent="lane_update"><mxGeometry x="30" y="230" width="220" height="55" as="geometry"/></mxCell>
        <mxCell id="clip" value="clip_grad_norm_" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;" vertex="1" parent="lane_update"><mxGeometry x="30" y="340" width="220" height="55" as="geometry"/></mxCell>
        <mxCell id="adamw" value="AdamW.step()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;fontStyle=1;" vertex="1" parent="lane_update"><mxGeometry x="30" y="450" width="220" height="55" as="geometry"/></mxCell>
        <mxCell id="updated" value="更新参数 θ&#xa;进入下一 batch / epoch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;fontStyle=1;" vertex="1" parent="lane_update"><mxGeometry x="30" y="560" width="220" height="70" as="geometry"/></mxCell>

        <mxCell id="val_data" value="Validation split&#xa;model.eval() + no_grad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;" vertex="1" parent="lane_select"><mxGeometry x="35" y="60" width="260" height="65" as="geometry"/></mxCell>
        <mxCell id="val_forward" value="同一 DA 模型前向&#xa;p_DA,val [N,24]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;" vertex="1" parent="lane_select"><mxGeometry x="35" y="165" width="260" height="65" as="geometry"/></mxCell>
        <mxCell id="val_policy" value="HardTopK + BESS&#xa;真实 DA 价事后结算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;fontColor=#7C2D12;" vertex="1" parent="lane_select"><mxGeometry x="35" y="270" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="val_metrics" value="验证指标&#xa;MAE / RMSE / mean_revenue&#xa;/ positive_day_rate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;fontColor=#14532D;" vertex="1" parent="lane_select"><mxGeometry x="35" y="380" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="checkpoint" value="按最高 mean_revenue&#xa;保存 best checkpoint&#xa;patience=3 早停" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;fontColor=#14532D;fontStyle=1;" vertex="1" parent="lane_select"><mxGeometry x="35" y="500" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="final_eval" value="最佳模型最终 Val / Test&#xa;+ LP oracle、regret（仅报告）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#64748B;fontColor=#334155;" vertex="1" parent="lane_select"><mxGeometry x="35" y="620" width="260" height="60" as="geometry"/></mxCell>

        <mxCell id="e_batch_model" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#3B82F6;" edge="1" parent="1" source="train_batch" target="da_model"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_model_pred" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#8B5CF6;" edge="1" parent="1" source="da_model" target="p_da"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_batch_truth" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#3B82F6;" edge="1" parent="1" source="train_batch" target="truth_da"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="45" y="280"/><mxPoint x="45" y="600"/></Array></mxGeometry></mxCell>
        <mxCell id="e_pred_lpred" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#EF4444;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_da" target="pred_loss"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_truth_lpred" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#3B82F6;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="truth_da" target="pred_loss"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_pred_perturb" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#F97316;" edge="1" parent="1" source="p_da" target="perturb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_perturb_policy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#F97316;" edge="1" parent="1" source="perturb" target="hardtopk"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_policy_bess" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#F97316;" edge="1" parent="1" source="hardtopk" target="bess"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_truth_bess" value="结算价" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;dashed=1;strokeColor=#3B82F6;fontColor=#1E3A8A;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="truth_da" target="bess"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_bess_grad" value="R⁺ / R⁻" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#F97316;fontColor=#7C2D12;" edge="1" parent="1" source="bess" target="zo_grad"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_grad_proxy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#EF4444;" edge="1" parent="1" source="zo_grad" target="proxy_loss"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_pred_proxy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;dashed=1;strokeColor=#EF4444;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_da" target="proxy_loss"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_lpred_total" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#EF4444;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="pred_loss" target="total_loss"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_proxy_total" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#EF4444;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="proxy_loss" target="total_loss"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_schedule_total" value="α, β" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;dashed=1;strokeColor=#F59E0B;fontColor=#78350F;" edge="1" parent="1" source="schedule" target="total_loss"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_total_zero" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#EF4444;" edge="1" parent="1" source="total_loss" target="zero_grad"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_zero_backward" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#EF4444;" edge="1" parent="1" source="zero_grad" target="backward"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_backward_clip" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#EF4444;" edge="1" parent="1" source="backward" target="clip"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_clip_adam" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#EF4444;" edge="1" parent="1" source="clip" target="adamw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_adam_updated" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#8B5CF6;" edge="1" parent="1" source="adamw" target="updated"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_update_model" value="下一轮" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;dashed=1;strokeColor=#8B5CF6;fontColor=#4C1D95;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="updated" target="da_model"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1020" y="780"/><mxPoint x="1020" y="830"/><mxPoint x="330" y="830"/><mxPoint x="330" y="340"/></Array></mxGeometry></mxCell>
        <mxCell id="e_val_data_forward" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#3B82F6;" edge="1" parent="1" source="val_data" target="val_forward"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_val_forward_policy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#F97316;" edge="1" parent="1" source="val_forward" target="val_policy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_val_policy_metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#22C55E;" edge="1" parent="1" source="val_policy" target="val_metrics"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_metrics_ckpt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#22C55E;" edge="1" parent="1" source="val_metrics" target="checkpoint"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ckpt_final" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#64748B;" edge="1" parent="1" source="checkpoint" target="final_eval"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="legend" value="图例" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;verticalAlign=top;fontStyle=1;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="30" y="850" width="970" height="90" as="geometry"/></mxCell>
        <mxCell id="leg_data" value="数据 / 真值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;" vertex="1" parent="legend"><mxGeometry x="15" y="38" width="135" height="30" as="geometry"/></mxCell>
        <mxCell id="leg_model" value="可训练模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;" vertex="1" parent="legend"><mxGeometry x="165" y="38" width="135" height="30" as="geometry"/></mxCell>
        <mxCell id="leg_fixed" value="固定策略 / 仿真" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;fontColor=#7C2D12;" vertex="1" parent="legend"><mxGeometry x="315" y="38" width="145" height="30" as="geometry"/></mxCell>
        <mxCell id="leg_output" value="输出 / 收益指标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;fontColor=#14532D;" vertex="1" parent="legend"><mxGeometry x="475" y="38" width="145" height="30" as="geometry"/></mxCell>
        <mxCell id="leg_loss" value="损失 / 反向传播" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;" vertex="1" parent="legend"><mxGeometry x="635" y="38" width="145" height="30" as="geometry"/></mxCell>
        <mxCell id="leg_control" value="调度 / 说明" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;" vertex="1" parent="legend"><mxGeometry x="795" y="38" width="145" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
