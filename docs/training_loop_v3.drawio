  <diagram name="训练回路 v3" id="train-v3">
    <mxGraphModel dx="2909" dy="834" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
