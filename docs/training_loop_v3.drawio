        <mxCell id="24" edge="1" parent="1" source="16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#78909C;dashed=1;dashPattern=6 3;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="23" value="&lt;span style=&quot;color: rgb(102, 102, 102);&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;同口径（含偏差罚金）&lt;/font&gt;&lt;/span&gt;">
