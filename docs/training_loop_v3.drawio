        <mxCell id="2" parent="1" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" value="&lt;div style=&quot;font-weight:bold;font-size:16px;color:#6A1B9A;&quot;&gt;正式实验版 (Full) — Decision-aware 训练回路 (双结算)&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#888;margin-top:3px;&quot;&gt;零阶梯度 (ZO) + HardTopK 策略 (不可微) + BESS 双结算仿真 | alpha/beta 退火&lt;/div&gt;" vertex="1">
