        <mxCell id="12" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#AB47BC;strokeWidth=2;dashed=1;dashPattern=8 4;" value="" vertex="1">
