        </mxCell>
        <mxCell id="13" parent="1" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" value="&lt;div style=&quot;font-weight: bold; font-size: 11px; color: rgb(171, 71, 188);&quot;&gt;零阶梯度路径 (不可微, 无 backward 穿过此区域)&lt;/div&gt;" vertex="1">
          <mxGeometry height="16" width="915" x="325" y="463" as="geometry" />
        </mxCell>
        <mxCell id="14" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#AB47BC;strokeWidth=1.5;" value="&lt;div style=&quot;font-weight: bold; font-size: 12px; color: rgb(123, 31, 162);&quot;&gt;1. HardTopK 策略 pi&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: rgb(119, 119, 119); margin-top: 2px;&quot;&gt;torch.topk 选 Top-K 放电 / Bot-K 充电 (不可微)&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: rgb(119, 119, 119); margin-top: 2px;&quot;&gt;价差门控: 仅保留 (c_dis - c_chg) &amp;gt; kappa/eta (约 28.4) 的配对&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="330" x="350" y="500" as="geometry" />
        </mxCell>
        <mxCell id="15" edge="1" parent="1" source="6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#AB47BC;" target="14" value="&lt;div style=&quot;text-align: start;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(102, 102, 102), rgb(149, 149, 149)); background-color: light-dark(#ffffff, var(--ge-dark-color, #121212)); font-size: 10px;&quot;&gt;价差 d = p_DA - p_RT | DA (定 日前动作 u_DA);&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: start;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(102, 102, 102), rgb(149, 149, 149)); background-color: light-dark(#ffffff, var(--ge-dark-color, #121212)); font-size: 10px;&quot;&gt;p_RT (定 实时动作 u_RT)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-1" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="16" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#66BB6A;strokeWidth=1.5;" value="&lt;div style=&quot;font-weight: bold; font-size: 12px; color: rgb(46, 125, 50);&quot;&gt;2. BESS 双结算仿真&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: rgb(119, 119, 119); margin-top: 2px;&quot;&gt;R = DA_leg + RT_leg - degradation - deviation_penalty&lt;/div&gt;&lt;div style=&quot;font-size: 9px; color: rgb(170, 170, 170); margin-top: 2px;&quot;&gt;退化 = kappa * (d_act + c_act); 偏差罚金 (若启用) = 2 | p_RT | *超3%部分&lt;/div&gt;" vertex="1">
          <mxGeometry height="55" width="310" x="910" y="495" as="geometry" />
        </mxCell>
        <mxCell id="17" edge="1" parent="1" source="14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#AB47BC;" target="16" value="&lt;span style=&quot;color: rgb(102, 102, 102);&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;u_DA [B,48], u_RT [B,24]&lt;/font&gt;&lt;/span&gt;">
          <mxGeometry relative="1" x="0.007" as="geometry">
