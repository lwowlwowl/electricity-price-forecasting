          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="19" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#AB47BC;strokeWidth=1.5;" value="&lt;div style=&quot;font-weight: bold; font-size: 12px; color: rgb(94, 53, 177);&quot;&gt;3. 零阶梯度估计&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: rgb(119, 119, 119); margin-top: 2px;&quot;&gt;双点高斯平滑: 扰动预测 &amp;gt; 策略 &amp;gt; 仿真 &amp;gt; 收益差&lt;/div&gt;&lt;div style=&quot;font-size: 9px; color: rgb(170, 170, 170); margin-top: 2px;&quot;&gt;对 DA / RT|DA / RT 三个任务独立扰动, K=2 对, rho=0.05&lt;/div&gt;" vertex="1">
          <mxGeometry height="55" width="470" x="350" y="583" as="geometry" />
        </mxCell>
        <mxCell id="20" parent="1" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" value="&lt;div style=&quot;font-size:9px;color:#AB47BC;font-style:italic;&quot;&gt;ZO 内部: 每个扰动样本 p+/p- 重复调用上面的 步骤1+步骤2 计算 R+/R-&lt;/div&gt;" vertex="1">
          <mxGeometry height="16" width="670" x="350" y="560" as="geometry" />
        </mxCell>
        <mxCell id="21" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#AB47BC;strokeWidth=1.5;" value="&lt;div style=&quot;font-weight:bold;font-size:12px;color:#5E35B1;&quot;&gt;4. 代理损失 L_proxy&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#777;margin-top:2px;&quot;&gt;L_proxy = p_hat * stopgrad(g_zo)&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#aaa;margin-top:2px;&quot;&gt;梯度注入: grad(L_proxy) = g_zo, 链式法则传回模型&lt;/div&gt;" vertex="1">
          <mxGeometry height="55" width="470" x="350" y="683" as="geometry" />
        </mxCell>
        <mxCell id="22" edge="1" parent="1" source="19" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#AB47BC;" target="21" value="&lt;span style=&quot;font-size:9px;color:#666;&quot;&gt;g_DA, g_RT|DA, g_RT&lt;/span&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="23" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#78909C;strokeWidth=1.5;dashed=1;dashPattern=6 3;" value="&lt;div style=&quot;font-weight: bold; font-size: 12px; color: rgb(84, 110, 122);&quot;&gt;Oracle 收益 R*_i&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: rgb(119, 119, 119); margin-top: 2px;&quot;&gt;真实 DA/RT 电价求对应 LP Oracle（无梯度）&lt;/div&gt;&lt;div style=&quot;font-size: 9px; color: rgb(170, 170, 170); margin-top: 2px;&quot;&gt;regret = R* - R_model | 训练时默认也计算(仅日志), 不参与梯度回传&lt;/div&gt;" vertex="1">
          <mxGeometry height="55" width="310" x="910" y="683" as="geometry" />
