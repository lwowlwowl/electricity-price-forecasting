<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="RT-at-DA训练回路" id="rt-at-da-training">
    <mxGraphModel dx="1500" dy="1180" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="RT-at-DA Transformer 训练与选模回路&#xa;纯Huber更新参数；冻结完整双结算收益选择checkpoint与融合结构" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1F2937;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="200" y="20" width="1100" height="60" as="geometry" /></mxCell>
        <mxCell id="dataset" value="RT-at-DA日样本&#xa;起报：D-1 10:00｜历史：[t-168,t)&#xa;输入：五条历史流 + 交付日Calendar&#xa;监督标签：D日24个真实RT价格" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="110" width="540" height="110" as="geometry" /></mxCell>
        <mxCell id="batch" value="DataLoader batch&#xa;训练集1809日｜验证集183日｜report-only 150日&#xa;训练统计量归一化；验证复用训练统计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="480" y="280" width="540" height="90" as="geometry" /></mxCell>
        <mxCell id="model" value="RT-at-DA 候选 Transformer fθ&#xa;五流独立编码 → F0/F1/F1b/F2融合 → 时间Memory&#xa;24-Query Decoder → p_RT_at_DA [B,24]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="430" width="540" height="100" as="geometry" /></mxCell>
        <mxCell id="target" value="真实RT标签&#xa;y_RT [B,24]&#xa;只作监督，不进入模型输入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="590" width="320" height="90" as="geometry" /></mxCell>
        <mxCell id="huber-loss" value="预测损失 L_pred&#xa;Huber(p_RT_at_DA, y_RT) / pred_scale&#xa;当前不含收益代理损失" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="590" width="500" height="90" as="geometry" /></mxCell>
        <mxCell id="backward" value="反向传播与更新&#xa;AMP → backward → grad clip → AdamW step&#xa;梯度只更新当前RT-at-DA实例" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1100" y="590" width="340" height="90" as="geometry" /></mxCell>
        <mxCell id="epoch-validation" value="每个epoch结束：冻结系统完整验证&#xa;融合消融合同：3个DA F1参考 + 原滚动RT seed 2&#xa;完整双结算收益更高 → 保存best_state；MAE/RMSE仅辅助" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="480" y="760" width="540" height="100" as="geometry" /></mxCell>
        <mxCell id="seed-checkpoint" value="单个seed输出&#xa;best_full_dual.pt + 训练JSON&#xa;F0/F1/F1b/F2使用相同切分与有效batch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="920" width="540" height="90" as="geometry" /></mxCell>
        <mxCell id="three-seeds" value="每种融合结构重复3个随机种子&#xa;F1b：110.39 / 112.63 / 109.74&#xa;均值 110.92 ± 1.52 USD/日" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="920" width="320" height="120" as="geometry" /></mxCell>
        <mxCell id="system-selection" value="融合结构选择（不反向传播）&#xa;F0/F1/F1b/F2均值：110.68 / 110.10 / 110.92 / 108.69&#xa;差值区间均跨0；最终部署F0 seed1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="900" width="360" height="140" as="geometry" /></mxCell>
        <mxCell id="test-once" value="report-only披露&#xa;2026-01至06月已被历史实验暴露&#xa;F1b三seed均值 68.75 USD/日，不用于回选" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="1080" width="500" height="80" as="geometry" /></mxCell>
        <mxCell id="boundary-note" value="当前边界&#xa;这里没有让完整收益对RT-at-DA模型联合反传；decision-aware训练属于后续任务。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="1080" width="320" height="80" as="geometry" /></mxCell>
        <mxCell id="e-data-batch" value="样本化" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dataset" target="batch"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-batch-model" value="模型输入键" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#9673a6;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="batch" target="model"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-batch-target" value="唯一监督标签" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;dashed=1;strokeColor=#666666;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="batch" target="target"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="410" /></Array></mxGeometry></mxCell>
        <mxCell id="e-model-loss" value="预测p_RT_at_DA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#b85450;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.65;entryY=0;" edge="1" parent="1" source="model" target="huber-loss"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-target-loss" value="y_RT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="target" target="huber-loss"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-loss-backward" value="标量loss" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#b85450;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="huber-loss" target="backward"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-backward-model" value="更新θ，继续下一batch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;curved=1;dashed=1;strokeColor=#b85450;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="backward" target="model"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1270" y="480" /></Array></mxGeometry></mxCell>
        <mxCell id="e-model-validation" value="epoch结束，eval()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#d79b00;strokeWidth=2;exitX=0.35;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="model" target="epoch-validation"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-validation-checkpoint" value="最高完整双结算验证收益" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="epoch-validation" target="seed-checkpoint"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-seeds-checkpoint" value="各自训练" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#6c8ebf;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="three-seeds" target="seed-checkpoint"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-checkpoint-selection" value="3个候选checkpoint" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#9673a6;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="seed-checkpoint" target="system-selection"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-selection-test" value="结构冻结后只作披露" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="system-selection" target="test-once"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
