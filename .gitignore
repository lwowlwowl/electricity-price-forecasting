# ============================================
# Python 项目 .gitignore
# ============================================

# --------------------------------------------
# 1. Python 编译缓存
# --------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --------------------------------------------
# 2. 虚拟环境（所有 .venv 目录）
# --------------------------------------------
**/.venv/
**/.venv-*/
.venv_forecast/
venv/
ENV/
env/

# --------------------------------------------
# 3. HuggingFace 缓存（大模型文件，不跟踪）
# --------------------------------------------
hf_cache/
# 如果缓存内有具体模型文件夹，也可以选择性保留
# 但通常模型权重很大，建议不跟踪

# --------------------------------------------
# 4. 第三方库源代码（从其他仓库 clone，不上传）
# --------------------------------------------
external/
# 如需重建，可从原仓库 clone：
#   git clone https://github.com/amazon-science/chronos-forecasting.git external/chronos-forecasting
#   git clone https://github.com/google-research/timesfm.git external/timesfm
#   git clone https://github.com/DataDog/toto.git external/toto

# --------------------------------------------
# 4. 数据文件（选择性忽略）
# --------------------------------------------
# 团队提供的统一市场数据包。目录内含 Excel/Parquet 大文件，不提交 Git。
data/markets/

# 处理后的数据（可重新生成）
data/processed/*.csv

# 预测结果（实验输出，不跟踪）
data/results/*.csv
data/results/*.png

# 但保留目录结构（使用 .gitkeep）
# data/processed/.gitkeep
# data/results/.gitkeep

# --------------------------------------------
# 5. Jupyter Notebook 检查点
# --------------------------------------------
.ipynb_checkpoints
*.ipynb

# --------------------------------------------
# 6. 环境变量文件（包含敏感信息）
# --------------------------------------------
.env
.env.local
.env.*.local
secrets.yaml
secrets.json
token.txt
*.token
*_token.txt
api_key.txt
*.pem
*.key

# --------------------------------------------
# 7. IDE 和编辑器配置
# --------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.vs/
*.sublime-project
*.sublime-workspace

# --------------------------------------------
# 8. 操作系统文件
# --------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --------------------------------------------
# 9. 日志文件
# --------------------------------------------
*.log
logs/
log/

# --------------------------------------------
# 10. 临时文件
# --------------------------------------------
runtime_cache/
tmp/
*.tmp
*.bak
*.backup
.chart-data-*/
.codex-build/
.codex-finalizer/

# --------------------------------------------
# 11. 测试相关（可选）
# --------------------------------------------
.pytest_cache/
.pytest_tmp/
.pytest_tmp*/
.test-tmp/
.coverage
htmlcov/
.tox/
.nox/

# Smoke/quick试跑只用于接口检查，不作为正式实验产物保存。
data/results/**/*smoke*/
data/results/**/*quick*/

# --------------------------------------------
# 12. 其他（根据项目需要添加）
# --------------------------------------------
# 如果 external/ 里有大文件，可以针对性忽略
# external/**/build/
# external/**/dist/

# 模型 checkpoint（二进制大文件，不入库）
data/checkpoints/
# 归档区旧 ElecFM checkpoint（8 GiB，纯本地存档，绝不入库）
data/archive/checkpoints/
# 兜底：任何 .pt/.pth 权重都不入库（需要共享请用 git-lfs 或网盘）
*.pt
*.pth
*.joblib
*.safetensors

# 长任务GPU遥测体积随运行时间增长，由最终计算成本摘要代替提交。
data/results/**/gpu_usage.csv

# 流水线心跳、运行状态和结果目录内的派生展示文件均可由正式脚本重建。
data/results/**/status.tsv
data/results/**/*.csv
data/results/**/*.png
data/results/**/*.md

# --------------------------------------------
# 13. 团队内部资料（按周归档，含个人/同学产出，不适合公开仓库）
# --------------------------------------------
docs/team_notes/

# --------------------------------------------
# 14. 本地 Agent 配置和第三方 Skills
# --------------------------------------------
# Claude Code 的本机权限白名单和绝对路径，不上传。
.claude/settings.local.json

# Codex 本地配置与第三方 Skills，不上传。
.codex/

# --------------------------------------------
# 15. 多节点实验的可重建运行产物
# --------------------------------------------
# 节点级/逐小时预测数组体积大，可由冻结checkpoint和正式脚本重建。
# 已经被Git跟踪的历史NPZ不会受此规则影响。
data/results/**/*.npz

# nohup/flock流水线运行锁，仅代表本机或云端的瞬时进程状态。
data/results/**/run.lock

# 上传前代码快照和完整结果归档；正式结论、哈希清单及JSON摘要继续提交。
data/results/**/*.tar
data/results/**/*.tar.gz

# --------------------------------------------
# 16. 实验JSON：默认不提交逐时轨迹和筛选中间产物
# --------------------------------------------
# 已经被Git跟踪的历史JSON不受影响。新结果默认忽略，只放行论文复现所需的
# 精简摘要、预注册协议、清单、审计结论和冻结配置。
data/results/*.json
data/results/**/*.json

!data/results/**/*summary*.json
!data/results/**/summary.json
!data/results/**/protocol.json
!data/results/**/manifest.json
!data/results/**/*audit*.json
!data/results/**/*preregistration*.json
!data/results/**/*claim*.json
!data/results/**/*closure*.json
!data/results/**/*comparison*.json
!data/results/**/LOCKED_2025_OPENED.json
!data/results/**/frozen_router.json
!data/results/**/followup_router.json

# 最终跨市场冻结评价本身不是中间MPC轨迹，单独保留。
!data/results/tail_expert_router_cross_market_2025_v1.json

# 已由进度文档汇总的基础模型探索及路由候选输入，不进入论文证据包。
data/results/chronos2*/**/*.json
data/results/**/*candidates*/**/*.json
data/results/**/*profit_inputs*/**/*.json

# 海报迭代稿不全部入库，只保留当前最高版本；源图和生成代码正常提交。
output/pptx/*
!output/pptx/FoSE_2026_Decision_Aware_Electricity_Forecasting_Poster_v14.pptx

# --------------------------------------------
# 17. LaTeX 编译与生成 PDF（由源码重新生成，不上传）
# --------------------------------------------
paper/**/*.aux
paper/**/*.out
paper/**/*.toc
paper/**/*.lof
paper/**/*.lot
paper/**/*.fls
paper/**/*.fdb_latexmk
paper/**/*.synctex.gz
paper/**/*.xdv
paper/**/*.bcf
paper/**/*.run.xml
paper/**/*.bbl
paper/**/*.blg
paper/**/main.pdf
output/pdf/

# --------------------------------------------
# 18. 本地编辑器/Agent 规则
# --------------------------------------------
# 持久的项目基线规则由 BASELINES.md 与配置注册表维护；本地 IDE 规则不上传。
.cursor/
